@prefix : <https://w3id.org/lcanet/ia#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/lcanet/ia#> .

<https://w3id.org/lcanet/ia> rdf:type owl:Ontology ;
                              owl:versionIRI <https://w3id.org/lcanet/ia/2.2.0> ;
                              <http://purl.org/dc/terms/creator> <https://orcid.org/0000-0002-0438-6831> ;
                              <http://purl.org/dc/terms/description> """The Impact Assessment module is part of the LCAnet ontology proposed by the SmartACV Carnot Project.
            It provides a formal representation of impact assessment concepts, methods, and characterization factors,
            enabling the evaluation and quantification of environmental impacts within the LCA process of a product or service.""" ;
                              <http://purl.org/dc/terms/issued> "2026-05-20"^^xsd:date ;
                              <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                              <http://purl.org/dc/terms/publisher> <https://www.cea.fr> ;
                              <http://purl.org/dc/terms/title> "The Impact Assessment module of the Life Cycle Assessment Network Ontology (LCAnet)."@en ;
                              <http://purl.org/vocab/vann/preferredNamespacePrefix> "ia" ;
                              <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/lcanet/ia#" ;
                              rdfs:label "LCAnet-ImpactAssessment" ;
                              owl:priorVersion "2.1.0" ;
                              owl:versionInfo "2.2.0" .

