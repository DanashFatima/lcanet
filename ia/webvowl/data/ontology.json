      "undefined" : "Ozone Depletion Footprint"
    },
    "comment" : {
      "undefined" : "Quantifies the potential stratospheric ozone layer depletion caused by substances emitted by a product throughout its life cycle. It is an ImpactResult linked to the Ozone Depletion impact category."
    },
