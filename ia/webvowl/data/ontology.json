    "baseIri" : "https://w3id.org/lcanet/ia",
    "instances" : 0,
    "label" : {
      "IRI-based" : "EnergyFootprint",
      "undefined" : "Energy Footprint"
    },
    "comment" : {
      "undefined" : "Quantifies the total energy use associated with a product throughout its life cycle, including renewable and non-renewable sources. EnergyFootprint is a FlowResult linked to the Energy FlowType."
    },
    "id" : "14",
    "superClasses" : [ "2" ]
  }, {
    "iri" : "https://w3id.org/lcanet/ia#MaterialFootprint",
    "baseIri" : "https://w3id.org/lcanet/ia",
    "instances" : 0,
    "label" : {
      "IRI-based" : "MaterialFootprint",
      "undefined" : "Material Footprint"
    },
    "comment" : {
      "undefined" : "refers to the total amount of raw materials extracted to meet final consumption demands. (ESPR Art 2 (26))."
    },
    "id" : "22",
    "superClasses" : [ "2" ]
  }, {
    "iri" : "https://w3id.org/lcanet/ia#AirPollutionFootprint",
    "baseIri" : "https://w3id.org/lcanet/ia",
    "instances" : 0,
    "label" : {
      "IRI-based" : "AirPollutionFootprint",
      "undefined" : "Air Pollution Footprint"
    },
    "comment" : {
      "undefined" : "Quantifies the release of airborne pollutants (e.g., particulate matter, photochemical ozone formation) over the life cycle of a product. AirPollutionFootprint is an ImpactResult associated with relevant environmental impact categories."
    },
    "id" : "25",
    "superClasses" : [ "2" ]
  }, {
    "iri" : "https://w3id.org/lcanet/ia#CharacterizationFactor",
    "baseIri" : "https://w3id.org/lcanet/ia",
    "instances" : 0,
    "label" : {
      "IRI-based" : "CharacterizationFactor",
      "undefined" : "Characterization Factor"
    },
    "comment" : {
      "undefined" : "Also called Impact factors, are factors that quantify the relative impact of different substances within the same category. These factors are used to convert the number of emissions into impact scores for each category."
    },
    "id" : "24"
  }, {
    "iri" : "https://w3id.org/lcanet/ia#CharacterizationModel",
    "baseIri" : "https://w3id.org/lcanet/ia",
    "instances" : 0,
    "label" : {
      "IRI-based" : "CharacterizationModel",
      "undefined" : "Characterization Model"
    },
    "comment" : {
      "undefined" : "A characterization model provides a mathmetical framework, as a set of equations, to quantify an impact category based on the chosen method. Example: IPCC (2021). A characterization model is used by a method."
    },
    "id" : "35"
  }, {
    "iri" : "https://w3id.org/lcanet/ia#CarbonFootprint",
    "baseIri" : "https://w3id.org/lcanet/ia",
    "instances" : 0,
    "label" : {
      "IRI-based" : "CarbonFootprint",
      "undefined" : "Carbon Footprint"
    },
    "comment" : {
      "undefined" : "means the sum of greenhouse gas emissions and greenhouse gas removals in a product system, expressed as CO equivalents and based on a life cycle assessment using the single impact category of climate change. (ESPR Art 2 25))"
    },
    "id" : "39",
    "superClasses" : [ "2" ]
  }, {
    "iri" : "https://w3id.org/lcanet/ia#ToxicityFootprint",
    "baseIri" : "https://w3id.org/lcanet/ia",
    "instances" : 0,
    "label" : {
      "IRI-based" : "ToxicityFootprint",
      "undefined" : "Toxicity Footprint"
    },
    "comment" : {
      "undefined" : "Quantifies the potential human health and ecological toxicity impacts of a product over its life cycle. ToxicityFootprint aggregates relevant ImpactCategories such as Human Toxicity (cancer and non-cancer) and Ecotoxicity."
    },
    "id" : "1",
    "superClasses" : [ "2" ]
  }, {
    "iri" : "https://w3id.org/lcanet/ia#EutrophicationFootprint",
    "baseIri" : "https://w3id.org/lcanet/ia",
    "instances" : 0,
    "label" : {
      "IRI-based" : "EutrophicationFootprint",
      "undefined" : "Eutophication Footprint"
    },
    "comment" : {
      "undefined" : "Quantifies nutrient enrichment impacts (eutrophication) on freshwater, marine, or terrestrial ecosystems caused by a product during its life cycle. It aggregates relevant ImpactCategories."
    },
    "id" : "51",
    "superClasses" : [ "2" ]
  }, {
    "iri" : "https://w3id.org/lcanet/ia#ImpactCategory",
    "baseIri" : "https://w3id.org/lcanet/ia",
    "instances" : 0,
    "label" : {
      "IRI-based" : "ImpactCategory",
      "undefined" : "Impact Category"
    },
    "comment" : {
      "undefined" : "An impact category represents a specific environmental issue that the LCA aims to assess, such as global warming or ozone depletion. Each category aggregates the effects of different emissions that contribute to the same environmental problem."
    },
    "id" : "20"
  }, {
    "iri" : "https://w3id.org/lcanet/ia#Method",
    "baseIri" : "https://w3id.org/lcanet/ia",
    "instances" : 0,
    "label" : {
      "IRI-based" : "Method",
      "undefined" : "Method"
    },
    "comment" : {
      "undefined" : "LCIA methods allow to transform raw emissions and resource data into understandable impact scores. Examples of methods include EN15804+A2, EF v3.1."
    },
    "id" : "11"
  }, {
    "iri" : "https://w3id.org/lcanet/ia#WaterFootprint",
    "baseIri" : "https://w3id.org/lcanet/ia",
    "instances" : 0,
    "label" : {
      "IRI-based" : "WaterFootprint",
      "undefined" : "Water Footprint"
    },
    "comment" : {
      "undefined" : "Quantifies the freshwater consumption associated with a product throughout its life cycle. WaterFootprint is a FlowResult linked to the Water FlowType."
    },
    "id" : "60",
    "superClasses" : [ "2" ]
  }, {
    "iri" : "https://w3id.org/lcanet/ia#LcaResult",
    "baseIri" : "https://w3id.org/lcanet/ia",
    "instances" : 0,
    "label" : {
      "IRI-based" : "LcaResult",
      "undefined" : "LCA Result"
    },
    "subClasses" : [ "1", "39", "51", "3", "22", "60", "14", "61", "25" ],
    "comment" : {
      "undefined" : "A LCA result corresponds to the computed value of each flow (or sometimes activity as a group of its input and output flows) concerning an impact category (IC). \nThus, it is an entity that makes links to: a flow/activity (e.g. flat chip resistor), an exact value (e.g. 1,16E-03), and an impact category (e.g. climate change), indicating the participation of this flow/activity in the studied impact category issue."
    },
    "id" : "2"
  }, {
    "iri" : "https://w3id.org/lcanet/ia#LandFootprint",
    "baseIri" : "https://w3id.org/lcanet/ia",
    "instances" : 0,
    "label" : {
      "IRI-based" : "LandFootprint",
      "undefined" : "Land Footprint"
    },
    "comment" : {
      "undefined" : "Quantifies the occupation and transformation of land caused by a product throughout its life cycle. LandFootprint is an ImpactResult linked to the LandUse impact category."
    },
    "id" : "61",
    "superClasses" : [ "2" ]
  }, {
    "iri" : "https://w3id.org/lcanet/ia#Methodology",
    "baseIri" : "https://w3id.org/lcanet/ia",
    "instances" : 0,
    "label" : {
      "IRI-based" : "Methodology",
      "undefined" : "Methodology"
    },
    "comment" : {
      "undefined" : "LCIA methodologies group related LCIA methods.\nA methodology (identified by an LCA expert for carrying out a specific LCA study), assesses some topic which is included in the scope of the LCA study."
    },
    "id" : "8"
  }, {
    "iri" : "https://w3id.org/lcanet/ia#OverallImpactResult",
    "baseIri" : "https://w3id.org/lcanet/ia",
    "instances" : 0,
    "label" : {
      "IRI-based" : "OverallImpactResult",
      "undefined" : "Overall Impact Result"
    },
    "comment" : {
      "undefined" : "It corresponds to the sum of all LCA result values of all flows/activities in the studied LCA of a product X, regarding an impact category Y."
    },
    "id" : "9"
  } ],
