}, {
  "@id" : "https://w3id.org/lcanet/ia",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/terms/creator" : [ {
    "@id" : "https://orcid.org/0000-0002-0438-6831"
  } ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "The Impact Assessment module is part of the LCAnet ontology proposed by the SmartACV Carnot Project.\n            It provides a formal representation of impact assessment concepts, methods, and characterization factors,\n            enabling the evaluation and quantification of environmental impacts within the LCA process of a product or service."
  } ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-05-20"
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@id" : "https://creativecommons.org/licenses/by/4.0/"
  } ],
  "http://purl.org/dc/terms/publisher" : [ {
    "@id" : "https://www.cea.fr"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "en",
    "@value" : "The Impact Assessment module of the Life Cycle Assessment Network Ontology (LCAnet)."
  } ],
  "http://purl.org/vocab/vann/preferredNamespacePrefix" : [ {
    "@value" : "ia"
  } ],
  "http://purl.org/vocab/vann/preferredNamespaceUri" : [ {
    "@value" : "https://w3id.org/lcanet/ia#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "LCAnet-ImpactAssessment"
  } ],
  "http://www.w3.org/2002/07/owl#priorVersion" : [ {
    "@value" : "2.1.0"
  } ],
  "http://www.w3.org/2002/07/owl#versionIRI" : [ {
    "@id" : "https://w3id.org/lcanet/ia/2.2.0"
  } ],
  "http://www.w3.org/2002/07/owl#versionInfo" : [ {
    "@value" : "2.2.0"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/ia#AirPollutionFootprint",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Quantifies the release of airborne pollutants (e.g., particulate matter, photochemical ozone formation) over the life cycle of a product. AirPollutionFootprint is an ImpactResult associated with relevant environmental impact categories."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Air Pollution Footprint"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lcanet/ia#LcaResult"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/ia#CarbonFootprint",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "means the sum of greenhouse gas emissions and greenhouse gas removals in a product system, expressed as CO equivalents and based on a life cycle assessment using the single impact category of climate change. (ESPR Art 2 25))"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Carbon Footprint"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lcanet/ia#LcaResult"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/ia#CharacterizationFactor",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Also called Impact factors, are factors that quantify the relative impact of different substances within the same category. These factors are used to convert the number of emissions into impact scores for each category."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Characterization Factor"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/lcanet/ia#CharacterizationModel"
  }, {
    "@id" : "https://w3id.org/lcanet/ia#ImpactCategory"
  }, {
    "@id" : "https://w3id.org/lcanet/ia#ImpactCategoryIndicator"
  }, {
    "@id" : "https://w3id.org/lcanet/ia#LcaResult"
  }, {
    "@id" : "https://w3id.org/lcanet/ia#Method"
  }, {
    "@id" : "https://w3id.org/lcanet/ia#Methodology"
  }, {
    "@id" : "https://w3id.org/lcanet/ia#OverallImpactResult"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/ia#CharacterizationModel",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A characterization model provides a mathmetical framework, as a set of equations, to quantify an impact category based on the chosen method. Example: IPCC (2021). A characterization model is used by a method."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Characterization Model"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/lcanet/ia#ImpactCategory"
  }, {
    "@id" : "https://w3id.org/lcanet/ia#ImpactCategoryIndicator"
  }, {
    "@id" : "https://w3id.org/lcanet/ia#LcaResult"
  }, {
    "@id" : "https://w3id.org/lcanet/ia#Method"
  }, {
    "@id" : "https://w3id.org/lcanet/ia#Methodology"
  }, {
    "@id" : "https://w3id.org/lcanet/ia#OverallImpactResult"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/ia#EnergyFootprint",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Quantifies the total energy use associated with a product throughout its life cycle, including renewable and non-renewable sources. EnergyFootprint is a FlowResult linked to the Energy FlowType."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Energy Footprint"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lcanet/ia#LcaResult"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/ia#EutrophicationFootprint",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Quantifies nutrient enrichment impacts (eutrophication) on freshwater, marine, or terrestrial ecosystems caused by a product during its life cycle. It aggregates relevant ImpactCategories."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Eutophication Footprint"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lcanet/ia#LcaResult"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/ia#ImpactCategory",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "An impact category represents a specific environmental issue that the LCA aims to assess, such as global warming or ozone depletion. Each category aggregates the effects of different emissions that contribute to the same environmental problem."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Impact Category"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/lcanet/ia#ImpactCategoryIndicator"
  }, {
    "@id" : "https://w3id.org/lcanet/ia#LcaResult"
  }, {
    "@id" : "https://w3id.org/lcanet/ia#Method"
  }, {
    "@id" : "https://w3id.org/lcanet/ia#Methodology"
  }, {
    "@id" : "https://w3id.org/lcanet/ia#OverallImpactResult"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/ia#ImpactCategoryIndicator",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "An impact category refers to a specific metric/measurable quantity that is used to quantify an impact category, such as Global Warming Potential (GWP) and Ozone Depletion Potential (ODP)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Impact Category Indicator"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/lcanet/ia#LcaResult"
  }, {
    "@id" : "https://w3id.org/lcanet/ia#Method"
  }, {
    "@id" : "https://w3id.org/lcanet/ia#Methodology"
  }, {
    "@id" : "https://w3id.org/lcanet/ia#OverallImpactResult"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/ia#LandFootprint",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Quantifies the occupation and transformation of land caused by a product throughout its life cycle. LandFootprint is an ImpactResult linked to the LandUse impact category."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Land Footprint"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lcanet/ia#LcaResult"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/ia#LcaResult",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A LCA result corresponds to the computed value of each flow (or sometimes activity as a group of its input and output flows) concerning an impact category (IC). \nThus, it is an entity that makes links to: a flow/activity (e.g. flat chip resistor), an exact value (e.g. 1,16E-03), and an impact category (e.g. climate change), indicating the participation of this flow/activity in the studied impact category issue."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "LCA Result"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/lcanet/ia#Method"
  }, {
    "@id" : "https://w3id.org/lcanet/ia#Methodology"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/ia#MaterialFootprint",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "refers to the total amount of raw materials extracted to meet final consumption demands. (ESPR Art 2 (26))."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Material Footprint"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lcanet/ia#LcaResult"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/ia#Method",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "LCIA methods allow to transform raw emissions and resource data into understandable impact scores. Examples of methods include EN15804+A2, EF v3.1."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Method"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/lcanet/ia#OverallImpactResult"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/ia#Methodology",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "LCIA methodologies group related LCIA methods.\nA methodology (identified by an LCA expert for carrying out a specific LCA study), assesses some topic which is included in the scope of the LCA study."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Methodology"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/lcanet/ia#OverallImpactResult"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/ia#OverallImpactResult",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "It corresponds to the sum of all LCA result values of all flows/activities in the studied LCA of a product X, regarding an impact category Y."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Overall Impact Result"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/ia#OzoneDepletionFootprint",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Quantifies the potential stratospheric ozone layer depletion caused by substances emitted by a product throughout its life cycle. It is an ImpactResult linked to the Ozone Depletion impact category."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Ozone Depletion Footprint"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lcanet/ia#LcaResult"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/ia#ToxicityFootprint",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Quantifies the potential human health and ecological toxicity impacts of a product over its life cycle. ToxicityFootprint aggregates relevant ImpactCategories such as Human Toxicity (cancer and non-cancer) and Ecotoxicity."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Toxicity Footprint"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lcanet/ia#LcaResult"
  } ]
}, {
