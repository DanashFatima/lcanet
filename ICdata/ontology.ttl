@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/lcanet/ICdata#> .

<https://w3id.org/lcanet/ICdata> rdf:type owl:Ontology ;
                                  owl:versionIRI <https://w3id.org/lcanet/ICdata/2.1.0> ;
                                  owl:imports <https://w3id.org/lcanet/core> ;
                                  <http://purl.org/dc/terms/creator> <https://orcid.org/0000-0002-0438-6831> ;
                                  <http://purl.org/dc/terms/description> """The Integrated Circuits (IC) knowledge graph representing the dataset from the IC use case, 
        used to demonstarte the convenince and applicability of the LCAnet ontology.""" ;
                                  <http://purl.org/dc/terms/issued> "2026-04-30"^^xsd:date ;
                                  <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                  <http://purl.org/dc/terms/publisher> <https://www.cea.fr> ;
                                  <http://purl.org/dc/terms/title> "The Integrated Circuits (IC) knowledge graph of the Life Cycle Assessment Network Ontology (LCAnet)."@en ;
                                  <http://purl.org/vocab/vann/preferredNamespacePrefix> "ic" ;
                                  <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/lcanet/ICdata#" ;
                                  rdfs:label "ICdata" ;
                                  owl:versionInfo "2.1.0" .

