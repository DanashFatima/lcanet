                                                  <https://w3id.org/lcanet/ia#quantifiedByCF> <https://w3id.org/lcanet/ICdata#3cde2dec99d14565a0fbd440b2e9a1e5> ;
                                                  <https://w3id.org/lcanet/property#hasUnit> "kg Sb -eq" .


