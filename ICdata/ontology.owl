    <!-- https://w3id.org/lcanet/ia#AirPollutionFootprint -->


    <owl:Class rdf:about="https://w3id.org/lcanet/ia#AirPollutionFootprint">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/lcanet/ia#LcaResult"/>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://w3id.org/lcanet/ia#hasIC"/>
                                <owl:hasValue rdf:resource="https://w3id.org/lcanet/ICdata#Particulate_matter"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://w3id.org/lcanet/ia#hasIC"/>
                                <owl:hasValue rdf:resource="https://w3id.org/lcanet/ICdata#Photochemical_ozone_formation_human_health"/>
                            </owl:Restriction>
                        </owl:unionOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/ia#CarbonFootprint -->


