<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/lcanet/ICdata#"
     xml:base="https://w3id.org/lcanet/ICdata"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:ia="https://w3id.org/lcanet/ia#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:core="https://w3id.org/lcanet/core#"
     xmlns:qudt="http://qudt.org/schema/qudt#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:time="http://www.w3.org/2006/time#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:activity="https://w3id.org/lcanet/activity#"
     xmlns:property="https://w3id.org/lcanet/property#">
    <owl:Ontology rdf:about="https://w3id.org/lcanet/ICdata">
        <owl:versionIRI rdf:resource="https://w3id.org/lcanet/ICdata/2.2.0"/>
        <owl:imports rdf:resource="https://w3id.org/lcanet/core"/>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0438-6831"/>
        <terms:description>The Integrated Circuits (IC) knowledge graph representing the dataset from the IC use case, 
        used to demonstarte the convenince and applicability of the LCAnet ontology.</terms:description>
        <terms:issued>2026-05-20</terms:issued>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:publisher rdf:resource="https://www.cea.fr"/>
        <terms:title xml:lang="en">The Integrated Circuits (IC) knowledge graph of the Life Cycle Assessment Network Ontology (LCAnet).</terms:title>
        <vann:preferredNamespacePrefix>ic</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/lcanet/ICdata#</vann:preferredNamespaceUri>
        <rdfs:label>ICdata</rdfs:label>
        <owl:priorVersion>2.1.0</owl:priorVersion>
        <owl:versionInfo>2.2.0</owl:versionInfo>
    </owl:Ontology>
    


