                    <rdf:Description rdf:about="https://w3id.org/lcanet/ia#OverallImpactResult"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/lcanet/ia#ImpactCategory"/>
        <rdfs:comment>relates a result to an impact category</rdfs:comment>
