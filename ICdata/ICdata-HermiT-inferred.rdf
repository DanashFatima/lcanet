        <rdf:type rdf:resource="https://w3id.org/lcanet/property#Property"/>
        <rdf:type rdf:resource="https://w3id.org/lcanet/property#QuantitativeProperty"/>
        <ia:assessIC rdf:resource="https://w3id.org/lcanet/ICdata#Acidification"/>
        <ia:assessIC rdf:resource="https://w3id.org/lcanet/ICdata#Eutrophication_terrestrial"/>
        <ia:quantifiedByCF rdf:resource="https://w3id.org/lcanet/ICdata#fcc6b6dc5ce0460b9abf365124c24b60"/>
