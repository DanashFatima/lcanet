        </rdfs:subPropertyOf>
        <rdfs:domain rdf:resource="https://w3id.org/lcanet/activity#ProductFlow"/>
        <rdfs:range rdf:resource="https://w3id.org/lcanet/activity#Activity"/>
        <rdfs:comment>relates a product flow to the activity it is inputted to</rdfs:comment>
        <rdfs:label>is Input Product Of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/activity#isOutputFlowOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/activity#isOutputFlowOf">
        <rdfs:domain rdf:resource="https://w3id.org/lcanet/activity#Flow"/>
        <rdfs:range rdf:resource="https://w3id.org/lcanet/activity#Activity"/>
        <rdfs:comment>relates a flow to the activity it is outputted from</rdfs:comment>
        <rdfs:label>is Output Flow Of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/activity#isOutputProductOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/activity#isOutputProductOf">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/lcanet/activity#isOutputFlowOf"/>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/lcanet/activity#hasOutputFlow"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <rdfs:domain rdf:resource="https://w3id.org/lcanet/activity#ProductFlow"/>
        <rdfs:range rdf:resource="https://w3id.org/lcanet/activity#Activity"/>
        <rdfs:comment>relates a product flow to the activity it is outputted from</rdfs:comment>
        <rdfs:label>is Output Product Of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/activity#isPartOfActivity -->

    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/activity#isPartOfActivity">
        <rdfs:domain rdf:resource="https://w3id.org/lcanet/activity#Activity"/>
        <rdfs:range rdf:resource="https://w3id.org/lcanet/activity#ComposedActivity"/>
        <rdfs:comment>relates an activity to the activity it is part of</rdfs:comment>
        <rdfs:label>is Part Of Activity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/activity#isStartActivityOf -->

    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/activity#isStartActivityOf">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/lcanet/activity#isPartOfActivity"/>
        <rdfs:subPropertyOf>
            <rdf:Description>
                <owl:inverseOf rdf:resource="https://w3id.org/lcanet/activity#hasActivityPart"/>
            </rdf:Description>
        </rdfs:subPropertyOf>
        <rdfs:domain rdf:resource="https://w3id.org/lcanet/activity#Activity"/>
        <rdfs:range rdf:resource="https://w3id.org/lcanet/activity#SequencedActivity"/>
        <rdfs:comment>relates an end activity to the activity it is part of as a sequence</rdfs:comment>
        <rdfs:label>is Start Activity Of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/actor#bearsResponsibility -->

    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/actor#bearsResponsibility">
        <owl:inverseOf rdf:resource="https://w3id.org/lcanet/actor#isBorneBy"/>
        <rdfs:domain rdf:resource="https://w3id.org/lcanet/actor#Agent"/>
        <rdfs:range rdf:resource="https://w3id.org/lcanet/actor#Responsibility"/>
        <rdfs:comment>relates an agent to the responsibility they bear</rdfs:comment>
        <rdfs:label>bears Responsibility</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/actor#entailedBy -->

    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/actor#entailedBy">
        <owl:inverseOf rdf:resource="https://w3id.org/lcanet/actor#entails"/>
        <rdfs:domain rdf:resource="https://w3id.org/lcanet/actor#Responsibility"/>
        <rdfs:range rdf:resource="https://w3id.org/lcanet/actor#Role"/>
        <rdfs:comment>relates a responsibility to the role it is entailed by</rdfs:comment>
        <rdfs:label>entailed By</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/actor#entails -->

    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/actor#entails">
