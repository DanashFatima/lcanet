<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/lcanet/ICdata-inferred#"
     xml:base="https://w3id.org/lcanet/ICdata-inferred"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:ia="https://w3id.org/lcanet/ia#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:core="https://w3id.org/lcanet/core#"
     xmlns:qudt="http://qudt.org/schema/qudt#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:time="http://www.w3.org/2006/time#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:activity="https://w3id.org/lcanet/activity#"
     xmlns:property="https://w3id.org/lcanet/property#">
    <owl:Ontology rdf:about="https://w3id.org/lcanet/ICdata-inferred">
        <owl:versionIRI rdf:resource="https://w3id.org/lcanet/ICdata-inferred/2.2.0"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0002-4553-3930"/>
        <terms:contributor rdf:resource="https://orcid.org/0000-0003-3896-7295"/>
        <terms:contributor rdf:resource="https://orcid.org/0009-0002-7928-9902"/>
        <terms:contributor>Emmanuelle Core</terms:contributor>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0438-6831"/>
        <terms:description>The Activity module is part of the LCAnet ontology proposed by the SmartACV Carnot Project.
            It provides a formal representation of activities and their associated flows, enabling 
            the modeling of activity/flow diagrams within the LCA realization of a product or service.</terms:description>
        <terms:description>The Actor module is part of the LCAnet ontology proposed by the SmartACV Carnot Project. 
            It provides a formal representation of actors (e.g., persons, organizations, and groups) 
            involved in LCA processes, as well as their roles and responsibilities. 
            It resuses some elements from the FOAF (Friend Of A Freind) ontology.</terms:description>
        <terms:description>The Core module is the central module of the LCAnet ontology proposed by the SmartACV Carnot Project.
            It defines the basic elements of a LCA study based on ISO 14040 and ISO 14044 such as the goal, scope, etc. 
            It also imports and links the other LCAnet ontology modules (Activity, Actor, Property, Spatiotemporal, and Impact Assessment)
            providing an integration layer between the modules.
            Thus, it serves as a semantic backbone for consistent modeling and reasoning over LCA knowledge.</terms:description>
        <terms:description>The Impact Assessment module is part of the LCAnet ontology proposed by the SmartACV Carnot Project.
            It provides a formal representation of impact assessment concepts, methods, and characterization factors,
            enabling the evaluation and quantification of environmental impacts within the LCA process of a product or service.</terms:description>
        <terms:description>The Integrated Circuits (IC) knowledge graph representing the dataset from the IC use case, 
        used to demonstarte the convenince and applicability of the LCAnet ontology.</terms:description>
        <terms:description>The Property module is part of the LCAnet ontology proposed by the SmartACV Carnot Project.
            It provides a formal representation of qualitative and quantitaive properties to 
            LCA processes and flows, enabling the description of LCA data for products or services.</terms:description>
        <terms:description>The Spatiotemporal module is part of the LCAnet ontology proposed by the SmartACV Carnot Project.
            It provides a formal representation of spatial and temporal aspects relevant to the LCA process,
            enabling the modeling and integration of location- and time-specific data for products or services.
            For the temporal aspect, it reuses classes and properties by importing the Time ontology: Time instant,
            Time interval, and DurationDescription. For the spatial aspect, it aligns with some pre-defined classes 
            from other ontologies such as the Feature class from the geonames vocabulary.</terms:description>
        <terms:issued>2026-05-20</terms:issued>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-20</terms:issued>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:publisher rdf:resource="https://www.cea.fr"/>
        <terms:title xml:lang="en">The Activity module of the Life Cycle Assessment Network Ontology (LCAnet).</terms:title>
        <terms:title xml:lang="en">The Actor module of the Life Cycle Assessment Network Ontology (LCAnet).</terms:title>
        <terms:title xml:lang="en">The Core module of the Life Cycle Assessment Network Ontology (LCAnet).</terms:title>
        <terms:title xml:lang="en">The Impact Assessment module of the Life Cycle Assessment Network Ontology (LCAnet).</terms:title>
        <terms:title xml:lang="en">The Integrated Circuits (IC) knowledge graph of the Life Cycle Assessment Network Ontology (LCAnet).</terms:title>
        <terms:title xml:lang="en">The Property module of the Life Cycle Assessment Network Ontology (LCAnet).</terms:title>
        <terms:title xml:lang="en">The Spatiotemporal module of the Life Cycle Assessment Network Ontology (LCAnet).</terms:title>
        <vann:preferredNamespacePrefix>act</vann:preferredNamespacePrefix>
        <vann:preferredNamespacePrefix>actor</vann:preferredNamespacePrefix>
        <vann:preferredNamespacePrefix>core</vann:preferredNamespacePrefix>
        <vann:preferredNamespacePrefix>ia</vann:preferredNamespacePrefix>
        <vann:preferredNamespacePrefix>ic</vann:preferredNamespacePrefix>
        <vann:preferredNamespacePrefix>prop</vann:preferredNamespacePrefix>
        <vann:preferredNamespacePrefix>st</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/lcanet/ICdata#</vann:preferredNamespaceUri>
        <vann:preferredNamespaceUri>https://w3id.org/lcanet/activity#</vann:preferredNamespaceUri>
        <vann:preferredNamespaceUri>https://w3id.org/lcanet/actor#</vann:preferredNamespaceUri>
        <vann:preferredNamespaceUri>https://w3id.org/lcanet/core#</vann:preferredNamespaceUri>
        <vann:preferredNamespaceUri>https://w3id.org/lcanet/ia#</vann:preferredNamespaceUri>
        <vann:preferredNamespaceUri>https://w3id.org/lcanet/property#</vann:preferredNamespaceUri>
        <vann:preferredNamespaceUri>https://w3id.org/lcanet/st#</vann:preferredNamespaceUri>
        <rdfs:comment>This ontology imports:
            - Activity module: https://w3id.org/lcanet/activity#
            - Actor module: https://w3id.org/lcanet/actor#
            - Impact Assessment module: https://w3id.org/lcanet/ia#
            - Property module: https://w3id.org/lcanet/property#
            - Spatiotemporal module: https://w3id.org/lcanet/st#
        </rdfs:comment>
        <rdfs:label>ICdata</rdfs:label>
        <rdfs:label>LCAnet-Activity</rdfs:label>
        <rdfs:label>LCAnet-Actor</rdfs:label>
        <rdfs:label>LCAnet-Core</rdfs:label>
        <rdfs:label>LCAnet-ImpactAssessment</rdfs:label>
        <rdfs:label>LCAnet-Property</rdfs:label>
        <rdfs:label>LCAnet-Spatiotemporal</rdfs:label>
        <owl:priorVersion>2.1.0</owl:priorVersion>
        <owl:versionInfo>2.2.0</owl:versionInfo>
    </owl:Ontology>
    


