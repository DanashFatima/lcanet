    <!-- http://purl.org/dc/terms/Agent -->

    <owl:Class rdf:about="http://purl.org/dc/terms/Agent">
        <owl:equivalentClass rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
    </owl:Class>
    


    <!-- http://xmlns.com/foaf/0.1/Agent -->

    <owl:Class rdf:about="http://xmlns.com/foaf/0.1/Agent">
        <owl:equivalentClass rdf:resource="https://w3id.org/lcanet/actor#Agent"/>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/actor#Agent -->

    <owl:Class rdf:about="https://w3id.org/lcanet/actor#Agent"/>
    


    <!-- http://www.geonames.org/ontology#Feature -->

    <owl:Class rdf:about="http://www.geonames.org/ontology#Feature">
        <owl:equivalentClass rdf:resource="https://schema.org/Place"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing"/>
    </owl:Class>
    


    <!-- https://schema.org/Place -->

    <owl:Class rdf:about="https://schema.org/Place">
        <owl:equivalentClass rdf:resource="https://w3id.org/lcanet/st#Location"/>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/st#Location -->

    <owl:Class rdf:about="https://w3id.org/lcanet/st#Location"/>
    


    <!-- http://www.w3.org/2003/01/geo/wgs84_pos#Point -->

    <owl:Class rdf:about="http://www.w3.org/2003/01/geo/wgs84_pos#Point">
        <owl:equivalentClass rdf:resource="https://w3id.org/lcanet/st#GeoPoint"/>
    </owl:Class>
    


    <!-- http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing -->

    <owl:Class rdf:about="http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing"/>
    


    <!-- http://www.w3.org/2006/time#Instant -->

    <owl:Class rdf:about="http://www.w3.org/2006/time#Instant"/>
    


    <!-- http://www.w3.org/2006/time#TemporalEntity -->

    <owl:Class rdf:about="http://www.w3.org/2006/time#TemporalEntity"/>
    


    <!-- http://xmlns.com/foaf/0.1/Agent -->

    <owl:Class rdf:about="http://xmlns.com/foaf/0.1/Agent"/>
    


    <!-- http://xmlns.com/foaf/0.1/Group -->

    <owl:Class rdf:about="http://xmlns.com/foaf/0.1/Group">
        <owl:equivalentClass rdf:resource="https://w3id.org/lcanet/actor#Group"/>
        <rdfs:subClassOf rdf:resource="http://purl.org/dc/terms/Agent"/>
        <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/actor#Agent"/>
    </owl:Class>
    


    <!-- http://xmlns.com/foaf/0.1/Organization -->

    <owl:Class rdf:about="http://xmlns.com/foaf/0.1/Organization">
        <owl:equivalentClass rdf:resource="https://w3id.org/lcanet/actor#Organization"/>
        <rdfs:subClassOf rdf:resource="http://purl.org/dc/terms/Agent"/>
        <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/actor#Agent"/>
    </owl:Class>
    


    <!-- http://xmlns.com/foaf/0.1/Person -->

    <owl:Class rdf:about="http://xmlns.com/foaf/0.1/Person">
        <owl:equivalentClass rdf:resource="https://w3id.org/lcanet/actor#Person"/>
        <rdfs:subClassOf rdf:resource="http://purl.org/dc/terms/Agent"/>
        <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/actor#Agent"/>
    </owl:Class>
    


    <!-- https://schema.org/AdministrativeArea -->

    <owl:Class rdf:about="https://schema.org/AdministrativeArea"/>
    


    <!-- https://schema.org/Place -->

    <owl:Class rdf:about="https://schema.org/Place">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing"/>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/activity#Activity -->

    <owl:Class rdf:about="https://w3id.org/lcanet/activity#Activity">
        <rdfs:comment>Represents a process or operation within the LCA system that consumes and/or produces flows.</rdfs:comment>
        <rdfs:label>Activity</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/activity#ActivityTag -->

    <owl:Class rdf:about="https://w3id.org/lcanet/activity#ActivityTag">
        <rdfs:label>Activity Tag</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/activity#Biosphere -->

    <owl:Class rdf:about="https://w3id.org/lcanet/activity#Biosphere">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/activity#EnvironemntalType"/>
        <rdfs:comment>Represents the natural environment external to the technosphere, 
including air, water, and soil compartments. It is the domain in which elementary 
flows originate or terminate, such as natural resource extraction and emissions.</rdfs:comment>
        <rdfs:label>Biosphere</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/activity#ComposedActivity -->

    <owl:Class rdf:about="https://w3id.org/lcanet/activity#ComposedActivity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/activity#Activity"/>
        <rdfs:comment>An activity that is made up of multiple sub-activities, which together represent a higher-level process.</rdfs:comment>
        <rdfs:label>Composed Activity</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/activity#ElementaryFlow -->

    <owl:Class rdf:about="https://w3id.org/lcanet/activity#ElementaryFlow">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/activity#Flow"/>
        <rdfs:comment>A flow that connects an activity directly with the natural environment i.e. has a biosphere  boundary.</rdfs:comment>
        <rdfs:label>Elementary Flow</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/activity#EmissionFlow -->

    <owl:Class rdf:about="https://w3id.org/lcanet/activity#EmissionFlow">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/activity#ElementaryFlow"/>
        <rdfs:comment>Represents an elementary flow corresponding to a substance or energy released from the technosphere into the biosphere. 
It includes emissions to environmental compartments such as air, water, and soil.</rdfs:comment>
        <rdfs:label>Emission Flow</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/activity#EnvironemntalType -->

    <owl:Class rdf:about="https://w3id.org/lcanet/activity#EnvironemntalType">
        <rdfs:comment>A classification of the environment into biosphere or technosphere, used to distinguish whether flows cross system boundaries or remain within the human-made system.</rdfs:comment>
        <rdfs:label>Environmental Type</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/activity#Flow -->

    <owl:Class rdf:about="https://w3id.org/lcanet/activity#Flow">
        <rdfs:comment>Represents the transfer of materials, energy, or resources between activities or between an activity and the environment.</rdfs:comment>
        <rdfs:label>Flow</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/activity#FlowTag -->

    <owl:Class rdf:about="https://w3id.org/lcanet/activity#FlowTag">
        <rdfs:label>Flow Tag</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/activity#IntermediateFlow -->

    <owl:Class rdf:about="https://w3id.org/lcanet/activity#IntermediateFlow">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/activity#Flow"/>
        <rdfs:comment>A flow that connects two activities within the technosphere, serving as an input to one activity and an output from another, or is wasted as waste.</rdfs:comment>
        <rdfs:label>Intermediate Flow</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/activity#ProductFlow -->

    <owl:Class rdf:about="https://w3id.org/lcanet/activity#ProductFlow">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/activity#IntermediateFlow"/>
        <rdfs:comment>Represents an intermediate flow within the technosphere corresponding to a product, service, or energy carrier with an associated economic value. 
Such flows are exchanged between activities as intended inputs or outputs within the life cycle system.</rdfs:comment>
        <rdfs:label>Product Flow</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/activity#ResourceFlow -->

    <owl:Class rdf:about="https://w3id.org/lcanet/activity#ResourceFlow">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/activity#ElementaryFlow"/>
        <rdfs:comment>Represents an elementary flow corresponding to a substance or energy extracted from the biosphere into the technosphere. 
It includes natural resources such as minerals, biomass, water, and energy carriers.</rdfs:comment>
        <rdfs:label>Resource Flow</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/activity#SequencedActivity -->

    <owl:Class rdf:about="https://w3id.org/lcanet/activity#SequencedActivity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/activity#ComposedActivity"/>
        <rdfs:comment>A composed activity in which the constituent sub-activities follow a specific temporal or logical sequence.</rdfs:comment>
        <rdfs:label>Sequenced Activity</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/activity#Technosphere -->

    <owl:Class rdf:about="https://w3id.org/lcanet/activity#Technosphere">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/activity#EnvironemntalType"/>
        <rdfs:comment>Represents the system of human activities and industrial processes 
within the life cycle of a product or service. It encompasses all transformations 
and exchanges of intermediate flows occurring within the economic system.</rdfs:comment>
        <rdfs:label>Technosphere</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/activity#WasteFlow -->

    <owl:Class rdf:about="https://w3id.org/lcanet/activity#WasteFlow">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/activity#IntermediateFlow"/>
        <rdfs:comment>Represents an intermediate flow within the technosphere corresponding to materials or substances that are discarded by an activity and require further treatment, recovery, or disposal. 
These flows are typically characterized by the absence of positive economic value for the producing activity.</rdfs:comment>
        <rdfs:label>Waste Flow</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/actor#Agency -->

    <owl:Class rdf:about="https://w3id.org/lcanet/actor#Agency">
        <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Organization"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/actor#Organization"/>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/actor#Agent -->

    <owl:Class rdf:about="https://w3id.org/lcanet/actor#Agent"/>
    


    <!-- https://w3id.org/lcanet/actor#Auditor -->

    <owl:Class rdf:about="https://w3id.org/lcanet/actor#Auditor">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/actor#Role"/>
        <rdfs:comment>Represents a type of role that an agent may assume when evaluating, reviewing, or verifying the conformity and quality of a life cycle assessment study or its results.</rdfs:comment>
        <rdfs:label>Auditor</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/actor#Consumer -->

    <owl:Class rdf:about="https://w3id.org/lcanet/actor#Consumer">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/actor#Role"/>
        <rdfs:comment>epresents a type of role that an agent may assume when using or consuming a product or service during its life cycle.</rdfs:comment>
        <rdfs:label>Consumer</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/actor#Customer -->

    <owl:Class rdf:about="https://w3id.org/lcanet/actor#Customer">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/actor#Role"/>
        <rdfs:comment>Represents a type of role that an agent may assume when acquiring or purchasing a product or service within its life cycle.</rdfs:comment>
        <rdfs:label>Customer</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/actor#Group -->

    <owl:Class rdf:about="https://w3id.org/lcanet/actor#Group">
        <rdfs:subClassOf rdf:resource="http://purl.org/dc/terms/Agent"/>
        <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/actor#Agent"/>
        <rdfs:comment>A collection of members (may or may not be formalized).</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/actor#Manufacturer -->

    <owl:Class rdf:about="https://w3id.org/lcanet/actor#Manufacturer">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/actor#Role"/>
        <rdfs:comment>Represents a type of role that an agent may assume when performing production or assembly activities within a life cycle system.</rdfs:comment>
        <rdfs:label>Manufacturer</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/actor#Organization -->

    <owl:Class rdf:about="https://w3id.org/lcanet/actor#Organization">
        <rdfs:subClassOf rdf:resource="http://purl.org/dc/terms/Agent"/>
        <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/actor#Agent"/>
        <rdfs:comment>A structured entity with identity and possibly legal status.</rdfs:comment>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/actor#Person -->

    <owl:Class rdf:about="https://w3id.org/lcanet/actor#Person">
        <rdfs:subClassOf rdf:resource="http://purl.org/dc/terms/Agent"/>
        <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/actor#Agent"/>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/actor#Recycler -->

    <owl:Class rdf:about="https://w3id.org/lcanet/actor#Recycler">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/actor#Role"/>
        <rdfs:comment>Represents a type of role that an agent may assume when performing recovery, recycling, or treatment operations on products or materials at the end-of-life stage.</rdfs:comment>
        <rdfs:label>Recycler</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/actor#Researcher -->

    <owl:Class rdf:about="https://w3id.org/lcanet/actor#Researcher">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/actor#Role"/>
        <rdfs:comment>Represents a type of role that an agent may assume when conducting analysis, modeling, or scientific studies related to life cycle assessment data, methods, or systems.</rdfs:comment>
        <rdfs:label>Researcher</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/actor#Role -->

    <owl:Class rdf:about="https://w3id.org/lcanet/actor#Role">
        <rdfs:comment>Represents a functional role that an agent can assume in a specific context.
Example: LCA Auditor, LCA Agency Role</rdfs:comment>
        <rdfs:label>Role</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/core#Interpretation -->

    <owl:Class rdf:about="https://w3id.org/lcanet/core#Interpretation">
        <rdfs:comment>The Interpretation class connects the LCA model to the Impact Assessment module, representing the analysis and interpretation of results to support decision-making, conclusions, and recommendations.</rdfs:comment>
        <rdfs:label>Interpretation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/core#LcaModel -->

    <owl:Class rdf:about="https://w3id.org/lcanet/core#LcaModel">
        <rdfs:comment>The LCA model class represents a complete Life Cycle Assessment instance within the LCAnet ontology network. 
Its instance ID encapsulates all aspects of the LCA study, linking to scope, goal, life cycle stages, and interpretation results.</rdfs:comment>
        <rdfs:label>LCA Model</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/core#LifeCycleStage -->

    <owl:Class rdf:about="https://w3id.org/lcanet/core#LifeCycleStage">
        <rdfs:comment>The LifeCycle stage class enumerates the standard stages of a product or service life cycle, providing an exhaustive list of the five possible stages for classification and analysis within the LCA.</rdfs:comment>
        <rdfs:label>Life Cycle Stage</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/core#Scope -->

    <owl:Class rdf:about="https://w3id.org/lcanet/core#Scope">
        <rdfs:comment>The Scope class captures the boundaries and context of an LCA study, including spatial and temporal aspects, functional unit, system boundaries, and assumptions, and a reference flow. Each element is represented via data properties connecting the Scope class to its corresponding values.</rdfs:comment>
        <rdfs:label>Scope</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/ia#AirPollutionFootprint -->

    <owl:Class rdf:about="https://w3id.org/lcanet/ia#AirPollutionFootprint">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/ia#LcaResult"/>
        <rdfs:comment>Quantifies the release of airborne pollutants (e.g., particulate matter, photochemical ozone formation) over the life cycle of a product. AirPollutionFootprint is an ImpactResult associated with relevant environmental impact categories.</rdfs:comment>
        <rdfs:label>Air Pollution Footprint</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/ia#CarbonFootprint -->

    <owl:Class rdf:about="https://w3id.org/lcanet/ia#CarbonFootprint">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/ia#LcaResult"/>
        <rdfs:comment>means the sum of greenhouse gas emissions and greenhouse gas removals in a product system, expressed as CO equivalents and based on a life cycle assessment using the single impact category of climate change. (ESPR Art 2 25))</rdfs:comment>
        <rdfs:label>Carbon Footprint</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/ia#CharacterizationFactor -->

    <owl:Class rdf:about="https://w3id.org/lcanet/ia#CharacterizationFactor">
        <rdfs:comment>Also called Impact factors, are factors that quantify the relative impact of different substances within the same category. These factors are used to convert the number of emissions into impact scores for each category.</rdfs:comment>
        <rdfs:label>Characterization Factor</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/ia#CharacterizationModel -->

    <owl:Class rdf:about="https://w3id.org/lcanet/ia#CharacterizationModel">
        <rdfs:comment>A characterization model provides a mathmetical framework, as a set of equations, to quantify an impact category based on the chosen method. Example: IPCC (2021). A characterization model is used by a method.</rdfs:comment>
        <rdfs:label>Characterization Model</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/ia#EnergyFootprint -->

    <owl:Class rdf:about="https://w3id.org/lcanet/ia#EnergyFootprint">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/ia#LcaResult"/>
        <rdfs:comment>Quantifies the total energy use associated with a product throughout its life cycle, including renewable and non-renewable sources. EnergyFootprint is a FlowResult linked to the Energy FlowType.</rdfs:comment>
        <rdfs:label>Energy Footprint</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/ia#EutrophicationFootprint -->

    <owl:Class rdf:about="https://w3id.org/lcanet/ia#EutrophicationFootprint">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/ia#LcaResult"/>
        <rdfs:comment>Quantifies nutrient enrichment impacts (eutrophication) on freshwater, marine, or terrestrial ecosystems caused by a product during its life cycle. It aggregates relevant ImpactCategories.</rdfs:comment>
        <rdfs:label>Eutophication Footprint</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/ia#ImpactCategory -->

    <owl:Class rdf:about="https://w3id.org/lcanet/ia#ImpactCategory">
        <rdfs:comment>An impact category represents a specific environmental issue that the LCA aims to assess, such as global warming or ozone depletion. Each category aggregates the effects of different emissions that contribute to the same environmental problem.</rdfs:comment>
        <rdfs:label>Impact Category</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/ia#ImpactCategoryIndicator -->

    <owl:Class rdf:about="https://w3id.org/lcanet/ia#ImpactCategoryIndicator">
        <rdfs:comment>An impact category refers to a specific metric/measurable quantity that is used to quantify an impact category, such as Global Warming Potential (GWP) and Ozone Depletion Potential (ODP).</rdfs:comment>
        <rdfs:label>Impact Category Indicator</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/ia#LandFootprint -->

    <owl:Class rdf:about="https://w3id.org/lcanet/ia#LandFootprint">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/ia#LcaResult"/>
        <rdfs:comment>Quantifies the occupation and transformation of land caused by a product throughout its life cycle. LandFootprint is an ImpactResult linked to the LandUse impact category.</rdfs:comment>
        <rdfs:label>Land Footprint</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/ia#LcaResult -->

    <owl:Class rdf:about="https://w3id.org/lcanet/ia#LcaResult">
        <rdfs:comment>A LCA result corresponds to the computed value of each flow (or sometimes activity as a group of its input and output flows) concerning an impact category (IC). 
Thus, it is an entity that makes links to: a flow/activity (e.g. flat chip resistor), an exact value (e.g. 1,16E-03), and an impact category (e.g. climate change), indicating the participation of this flow/activity in the studied impact category issue.</rdfs:comment>
        <rdfs:label>LCA Result</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/ia#MaterialFootprint -->

    <owl:Class rdf:about="https://w3id.org/lcanet/ia#MaterialFootprint">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/ia#LcaResult"/>
        <rdfs:comment>refers to the total amount of raw materials extracted to meet final consumption demands. (ESPR Art 2 (26)).</rdfs:comment>
        <rdfs:label>Material Footprint</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/ia#Method -->

    <owl:Class rdf:about="https://w3id.org/lcanet/ia#Method">
        <rdfs:comment>LCIA methods allow to transform raw emissions and resource data into understandable impact scores. Examples of methods include EN15804+A2, EF v3.1.</rdfs:comment>
        <rdfs:label>Method</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/ia#Methodology -->

    <owl:Class rdf:about="https://w3id.org/lcanet/ia#Methodology">
        <rdfs:comment>LCIA methodologies group related LCIA methods.
A methodology (identified by an LCA expert for carrying out a specific LCA study), assesses some topic which is included in the scope of the LCA study.</rdfs:comment>
        <rdfs:label>Methodology</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/ia#OverallImpactResult -->

    <owl:Class rdf:about="https://w3id.org/lcanet/ia#OverallImpactResult">
        <rdfs:comment>It corresponds to the sum of all LCA result values of all flows/activities in the studied LCA of a product X, regarding an impact category Y.</rdfs:comment>
        <rdfs:label>Overall Impact Result</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/ia#OzoneDepletionFootprint -->

    <owl:Class rdf:about="https://w3id.org/lcanet/ia#OzoneDepletionFootprint">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/ia#LcaResult"/>
        <rdfs:comment>Quantifies the potential stratospheric ozone layer depletion caused by substances emitted by a product throughout its life cycle. It is an ImpactResult linked to the Ozone Depletion impact category.</rdfs:comment>
        <rdfs:label>Ozone Depletion Footprint</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/ia#ToxicityFootprint -->

    <owl:Class rdf:about="https://w3id.org/lcanet/ia#ToxicityFootprint">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/ia#LcaResult"/>
        <rdfs:comment>Quantifies the potential human health and ecological toxicity impacts of a product over its life cycle. ToxicityFootprint aggregates relevant ImpactCategories such as Human Toxicity (cancer and non-cancer) and Ecotoxicity.</rdfs:comment>
        <rdfs:label>Toxicity Footprint</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/ia#WaterFootprint -->

    <owl:Class rdf:about="https://w3id.org/lcanet/ia#WaterFootprint">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/ia#LcaResult"/>
        <rdfs:comment>Quantifies the freshwater consumption associated with a product throughout its life cycle. WaterFootprint is a FlowResult linked to the Water FlowType.</rdfs:comment>
        <rdfs:label>Water Footprint</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/property#BalanceableProperty -->

    <owl:Class rdf:about="https://w3id.org/lcanet/property#BalanceableProperty">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/property#QuantitativeProperty"/>
        <rdfs:comment>A property representing a flow of materials, energy, or emissions that is tracked and balanced in life cycle assessment studies.</rdfs:comment>
        <rdfs:label>Balanceable Property</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/property#DataQualityProperty -->

    <owl:Class rdf:about="https://w3id.org/lcanet/property#DataQualityProperty">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/property#QuantitativeProperty"/>
        <rdfs:comment>A property that represents the quality, reliability, or validity of data associated with an entity or measurement.</rdfs:comment>
        <rdfs:label>Data Quality Property</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/property#Property -->

    <owl:Class rdf:about="https://w3id.org/lcanet/property#Property">
        <rdfs:label>Property</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/property#QualitativeProperty -->

    <owl:Class rdf:about="https://w3id.org/lcanet/property#QualitativeProperty">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/property#Property"/>
        <rdfs:comment>A property that represents a descriptive or categorical characteristic of an entity.</rdfs:comment>
        <rdfs:label>Qualitative Property</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/property#QuantitativeProperty -->

    <owl:Class rdf:about="https://w3id.org/lcanet/property#QuantitativeProperty">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/property#Property"/>
        <rdfs:comment>A property that represents a measurable numeric quantity associated with an entity.</rdfs:comment>
        <rdfs:label>Quantitative Property</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/st#AdministrativeRegion -->

    <owl:Class rdf:about="https://w3id.org/lcanet/st#AdministrativeRegion">
        <rdfs:subClassOf rdf:resource="http://www.geonames.org/ontology#Feature"/>
        <rdfs:subClassOf rdf:resource="https://schema.org/AdministrativeArea"/>
        <rdfs:subClassOf rdf:resource="https://schema.org/Place"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/st#Location"/>
        <rdfs:comment>A political or administrative territorial unit, such as a country, state, province, or city.
        Aligns with schema:AdministrativeArea and gn:Feature.</rdfs:comment>
        <rdfs:label>Administrative Region</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/st#GeoPoint -->

    <owl:Class rdf:about="https://w3id.org/lcanet/st#GeoPoint">
        <rdfs:comment>A geographic point represented by WGS84 latitude and longitude coordinates.</rdfs:comment>
        <rdfs:label>GeoPoint</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/st#GlobalScale -->

    <owl:Class rdf:about="https://w3id.org/lcanet/st#GlobalScale">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/st#SpatialScale"/>
        <rdfs:label>Global Scale</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/st#LocalScale -->

    <owl:Class rdf:about="https://w3id.org/lcanet/st#LocalScale">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/st#SpatialScale"/>
        <rdfs:label>Local Scale</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/st#Location -->

    <owl:Class rdf:about="https://w3id.org/lcanet/st#Location">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing"/>
        <rdfs:comment>A general spatial entity representing any identifiable place or geographic feature.
            Equivalent to schema:Place and gn:Feature.
        </rdfs:comment>
        <rdfs:label>Location</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/st#NationalScale -->

    <owl:Class rdf:about="https://w3id.org/lcanet/st#NationalScale">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/st#SpatialScale"/>
        <rdfs:label>National Scale</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/st#RegionalScale -->

    <owl:Class rdf:about="https://w3id.org/lcanet/st#RegionalScale">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/st#SpatialScale"/>
        <rdfs:label>Regional Scale</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/st#Site -->

    <owl:Class rdf:about="https://w3id.org/lcanet/st#Site">
        <rdfs:subClassOf rdf:resource="http://www.geonames.org/ontology#Feature"/>
        <rdfs:subClassOf rdf:resource="https://schema.org/Place"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/st#Location"/>
        <rdfs:comment>
            A specific location associated with an activity, facility, installation, or process.
            Examples: LCA process site, production site, waste treatment site.
        </rdfs:comment>
        <rdfs:label>Site</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/st#SpatialScale -->

    <owl:Class rdf:about="https://w3id.org/lcanet/st#SpatialScale">
        <rdfs:comment>
            A classification of the level of spatial granularity applied in an LCA study,
            such as global, continental, national, regional, or local scale.
            Used for specifying the spatial resolution of data or impacts.
        </rdfs:comment>
        <rdfs:label>Spatial Scale</rdfs:label>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/lcanet/ICdata#Abiotic_resource_depletion_ADP_ultimate_reserves -->

    <owl:NamedIndividual rdf:about="https://w3id.org/lcanet/ICdata#Abiotic_resource_depletion_ADP_ultimate_reserves">
        <rdf:type rdf:resource="https://w3id.org/lcanet/ia#CharacterizationFactor"/>
        <rdf:type rdf:resource="https://w3id.org/lcanet/ia#ImpactCategoryIndicator"/>
        <rdf:type rdf:resource="https://w3id.org/lcanet/property#Property"/>
        <rdf:type rdf:resource="https://w3id.org/lcanet/property#QuantitativeProperty"/>
        <rdfs:label>Abiotic resource depletion (ADP ultimate reserves)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/lcanet/ICdata#Accumulated_Exceedance -->

    <owl:NamedIndividual rdf:about="https://w3id.org/lcanet/ICdata#Accumulated_Exceedance">
        <rdf:type rdf:resource="https://w3id.org/lcanet/ia#CharacterizationModel"/>
        <terms:bibliographicCitation>(Seppälä et al. 2006, Posch et al, 2008)</terms:bibliographicCitation>
        <rdfs:label>Accumulated Exceedance</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/lcanet/ICdata#Accumulated_Exceedance_AE -->

    <owl:NamedIndividual rdf:about="https://w3id.org/lcanet/ICdata#Accumulated_Exceedance_AE">
        <rdf:type rdf:resource="https://w3id.org/lcanet/ia#ImpactCategoryIndicator"/>
        <rdf:type rdf:resource="https://w3id.org/lcanet/property#Property"/>
        <rdf:type rdf:resource="https://w3id.org/lcanet/property#QuantitativeProperty"/>
        <rdfs:label>Accumulated Exceedance (AE)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/lcanet/ICdata#Acidification -->

    <owl:NamedIndividual rdf:about="https://w3id.org/lcanet/ICdata#Acidification">
        <rdf:type rdf:resource="https://w3id.org/lcanet/ia#ImpactCategory"/>
