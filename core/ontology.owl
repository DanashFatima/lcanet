    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/contributor -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/contributor"/>
    


    <!-- http://purl.org/dc/terms/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/issued -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/issued"/>
    


    <!-- http://purl.org/dc/terms/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/publisher -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/publisher"/>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespaceUri -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/lcanet/core#activityBelongsToLCstage -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/core#activityBelongsToLCstage">
        <rdfs:domain rdf:resource="https://w3id.org/lcanet/activity#Activity"/>
        <rdfs:range rdf:resource="https://w3id.org/lcanet/core#LifeCycleStage"/>
        <rdfs:label>activity belongs to LC stage</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/core#activityHasImpactResult -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/core#activityHasImpactResult">
        <owl:inverseOf rdf:resource="https://w3id.org/lcanet/core#impactResultConcernsActivity"/>
        <rdfs:label>activity has Impact Result</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/core#flowHasImpactResult -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/core#flowHasImpactResult">
        <owl:inverseOf rdf:resource="https://w3id.org/lcanet/core#impactResultConcernsFlow"/>
        <rdfs:label>flow has Impact Result</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/core#hasFlowCategory -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/core#hasFlowCategory">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/lcanet/ia#LcaResult"/>
                    <rdf:Description rdf:about="https://w3id.org/lcanet/ia#OverallImpactResult"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/lcanet/activity#FlowTag"/>
        <rdfs:label>has Flow Category</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/core#hasProperty -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/core#hasProperty">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/lcanet/activity#Activity"/>
                    <rdf:Description rdf:about="https://w3id.org/lcanet/activity#Flow"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/lcanet/property#Property"/>
        <rdfs:label>has Property</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/core#hasSpatialAspect -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/core#hasSpatialAspect">
        <rdfs:domain rdf:resource="https://w3id.org/lcanet/activity#Activity"/>
        <rdfs:range rdf:resource="https://w3id.org/lcanet/st#Location"/>
        <rdfs:label>has Spatial Aspect</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/core#hasTemporalAspect -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/core#hasTemporalAspect">
        <rdfs:domain rdf:resource="https://w3id.org/lcanet/activity#Activity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
        <rdfs:label>has Temporal Aspect</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/core#impactResultConcernsActivity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/core#impactResultConcernsActivity">
        <rdfs:domain rdf:resource="https://w3id.org/lcanet/ia#LcaResult"/>
        <rdfs:range rdf:resource="https://w3id.org/lcanet/activity#Activity"/>
        <rdfs:label>impact Result Concerns Activity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/core#impactResultConcernsFlow -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/core#impactResultConcernsFlow">
        <rdfs:domain rdf:resource="https://w3id.org/lcanet/ia#LcaResult"/>
        <rdfs:range rdf:resource="https://w3id.org/lcanet/activity#Flow"/>
        <rdfs:label>impact Result Concerns Flow</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/core#interpretationContainsOIR -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/core#interpretationContainsOIR">
        <rdfs:domain rdf:resource="https://w3id.org/lcanet/core#Interpretation"/>
        <rdfs:range rdf:resource="https://w3id.org/lcanet/ia#OverallImpactResult"/>
        <rdfs:label>interpretation contains OIR</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/core#interpretationDefinedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/core#interpretationDefinedBy">
        <rdfs:domain rdf:resource="https://w3id.org/lcanet/core#Interpretation"/>
        <rdfs:range rdf:resource="https://w3id.org/lcanet/actor#Agent"/>
        <rdfs:label>interpretation defined by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/core#lcaModeHasScope -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/core#lcaModeHasScope">
        <rdfs:domain rdf:resource="https://w3id.org/lcanet/core#LcaModel"/>
        <rdfs:range rdf:resource="https://w3id.org/lcanet/core#Scope"/>
        <rdfs:label>lca model has scope</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/core#lcaModelConcernsLCStage -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/core#lcaModelConcernsLCStage">
        <rdfs:domain rdf:resource="https://w3id.org/lcanet/core#LcaModel"/>
        <rdfs:range rdf:resource="https://w3id.org/lcanet/core#LifeCycleStage"/>
        <rdfs:label>lca model concerns LC stage</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/core#lcaModelHasAuthor -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/core#lcaModelHasAuthor">
        <rdfs:domain rdf:resource="https://w3id.org/lcanet/core#LcaModel"/>
        <rdfs:range rdf:resource="https://w3id.org/lcanet/actor#Agent"/>
        <rdfs:label>lca model has author</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/core#lcaModelResultsInInterpretation -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/core#lcaModelResultsInInterpretation">
        <rdfs:domain rdf:resource="https://w3id.org/lcanet/core#LcaModel"/>
        <rdfs:range rdf:resource="https://w3id.org/lcanet/core#Interpretation"/>
        <rdfs:label>lca model results in interpretation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/core#methodologyAssessesTopic -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/core#methodologyAssessesTopic">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/lcanet/ia#Method"/>
                    <rdf:Description rdf:about="https://w3id.org/lcanet/ia#Methodology"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/lcanet/core#Scope"/>
        <rdfs:label>methodology assesses topic</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/core#realizedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/core#realizedBy">
        <owl:inverseOf rdf:resource="https://w3id.org/lcanet/core#realizesActivity"/>
        <rdfs:domain rdf:resource="https://w3id.org/lcanet/activity#Activity"/>
        <rdfs:range rdf:resource="https://w3id.org/lcanet/actor#Agent"/>
        <rdfs:label>realized by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/core#realizesActivity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/core#realizesActivity">
        <rdfs:label>realizes activity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/core#scopeDefinedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/core#scopeDefinedBy">
        <rdfs:domain rdf:resource="https://w3id.org/lcanet/core#Scope"/>
        <rdfs:range rdf:resource="https://w3id.org/lcanet/actor#Agent"/>
        <rdfs:label>scope defined by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/core#scopeHasReferenceFlow -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/core#scopeHasReferenceFlow">
        <rdfs:domain rdf:resource="https://w3id.org/lcanet/core#Scope"/>
        <rdfs:range rdf:resource="https://w3id.org/lcanet/activity#ProductFlow"/>
        <rdfs:label>scope has reference flow</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/core#scopeHasSpatialScale -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/core#scopeHasSpatialScale">
        <rdfs:domain rdf:resource="https://w3id.org/lcanet/core#Scope"/>
        <rdfs:range rdf:resource="https://w3id.org/lcanet/st#SpatialScale"/>
        <rdfs:label>scope has spatial scale</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/core#scopeHasTemporalScale -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/core#scopeHasTemporalScale">
        <rdfs:domain rdf:resource="https://w3id.org/lcanet/core#Scope"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
        <rdfs:label>scope has temporal scale</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/core#usedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/core#usedBy">
        <rdfs:domain rdf:resource="https://w3id.org/lcanet/activity#Flow"/>
        <rdfs:range rdf:resource="https://w3id.org/lcanet/actor#Agent"/>
        <rdfs:label>used by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/ia#assessIC -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/ia#assessIC"/>
    


    <!-- https://w3id.org/lcanet/ia#calculatedByCM -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/ia#calculatedByCM"/>
    


    <!-- https://w3id.org/lcanet/ia#calculatesCF -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/ia#calculatesCF"/>
    


    <!-- https://w3id.org/lcanet/ia#hasIC -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/ia#hasIC"/>
    


    <!-- https://w3id.org/lcanet/ia#quantifiedByCF -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/ia#quantifiedByCF"/>
    


    <!-- https://w3id.org/lcanet/ia#quantifiesICI -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/ia#quantifiesICI"/>
    


    <!-- https://w3id.org/lcanet/ia#usesCM -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/ia#usesCM"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://qudt.org/schema/qudt#numericValue -->


    <owl:DatatypeProperty rdf:about="http://qudt.org/schema/qudt#numericValue"/>
    


    <!-- https://w3id.org/lcanet/core#lcaModelHasGoal -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/lcanet/core#lcaModelHasGoal">
        <rdfs:domain rdf:resource="https://w3id.org/lcanet/core#LcaModel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>The lcaModelHasGoal data property represents the objective of the LCA study, defined as a textual description that specifies the intended purpose and use of the LCA results.</rdfs:comment>
        <rdfs:label>lca Model Has Goal</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/lcanet/core#lcaModelHasId -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/lcanet/core#lcaModelHasId">
        <rdfs:domain rdf:resource="https://w3id.org/lcanet/core#LcaModel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>lca Model Has Id</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/lcanet/core#scopeHasAssumption -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/lcanet/core#scopeHasAssumption">
        <rdfs:domain rdf:resource="https://w3id.org/lcanet/core#Scope"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>scope Has Assumption</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/lcanet/core#scopeHasFunctionalUnit -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/lcanet/core#scopeHasFunctionalUnit">
        <rdfs:domain rdf:resource="https://w3id.org/lcanet/core#Scope"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>scope Has Functional Unit</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/lcanet/core#scopeHasSystemBoundary -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/lcanet/core#scopeHasSystemBoundary">
        <rdfs:domain rdf:resource="https://w3id.org/lcanet/core#Scope"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>Scope Has System Boundary</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/lcanet/property#hasUnit -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/lcanet/property#hasUnit"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2006/time#TemporalEntity -->


    <owl:Class rdf:about="http://www.w3.org/2006/time#TemporalEntity"/>
    


    <!-- https://w3id.org/lcanet/activity#Activity -->


    <owl:Class rdf:about="https://w3id.org/lcanet/activity#Activity"/>
    


    <!-- https://w3id.org/lcanet/activity#ActivityTag -->


    <owl:Class rdf:about="https://w3id.org/lcanet/activity#ActivityTag"/>
    


    <!-- https://w3id.org/lcanet/activity#Biosphere -->


    <owl:Class rdf:about="https://w3id.org/lcanet/activity#Biosphere"/>
    


    <!-- https://w3id.org/lcanet/activity#Flow -->


    <owl:Class rdf:about="https://w3id.org/lcanet/activity#Flow"/>
    


    <!-- https://w3id.org/lcanet/activity#FlowTag -->


    <owl:Class rdf:about="https://w3id.org/lcanet/activity#FlowTag"/>
    


    <!-- https://w3id.org/lcanet/activity#ProductFlow -->


    <owl:Class rdf:about="https://w3id.org/lcanet/activity#ProductFlow"/>
    


    <!-- https://w3id.org/lcanet/activity#Technosphere -->


    <owl:Class rdf:about="https://w3id.org/lcanet/activity#Technosphere"/>
    


    <!-- https://w3id.org/lcanet/actor#Agent -->


    <owl:Class rdf:about="https://w3id.org/lcanet/actor#Agent"/>
    


    <!-- https://w3id.org/lcanet/core#Interpretation -->


    <owl:Class rdf:about="https://w3id.org/lcanet/core#Interpretation">
        <rdfs:comment>The Interpretation class connects the LCA model to the Impact Assessment module, representing the analysis and interpretation of results to support decision-making, conclusions, and recommendations.</rdfs:comment>
        <rdfs:label>Interpretation</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/core#LcaModel -->


    <owl:Class rdf:about="https://w3id.org/lcanet/core#LcaModel">
        <rdfs:comment>The LCA model class represents a complete Life Cycle Assessment instance within the LCAnet ontology network. 
Its instance ID encapsulates all aspects of the LCA study, linking to scope, goal, life cycle stages, and interpretation results.</rdfs:comment>
        <rdfs:label>LCA Model</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/core#LifeCycleStage -->


    <owl:Class rdf:about="https://w3id.org/lcanet/core#LifeCycleStage">
        <rdfs:comment>The LifeCycle stage class enumerates the standard stages of a product or service life cycle, providing an exhaustive list of the five possible stages for classification and analysis within the LCA.</rdfs:comment>
        <rdfs:label>Life Cycle Stage</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/core#Scope -->


    <owl:Class rdf:about="https://w3id.org/lcanet/core#Scope">
        <rdfs:comment>The Scope class captures the boundaries and context of an LCA study, including spatial and temporal aspects, functional unit, system boundaries, and assumptions, and a reference flow. Each element is represented via data properties connecting the Scope class to its corresponding values.</rdfs:comment>
        <rdfs:label>Scope</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/ia#CharacterizationFactor -->


    <owl:Class rdf:about="https://w3id.org/lcanet/ia#CharacterizationFactor"/>
    


    <!-- https://w3id.org/lcanet/ia#CharacterizationModel -->


    <owl:Class rdf:about="https://w3id.org/lcanet/ia#CharacterizationModel"/>
    


    <!-- https://w3id.org/lcanet/ia#ImpactCategory -->


    <owl:Class rdf:about="https://w3id.org/lcanet/ia#ImpactCategory"/>
    


    <!-- https://w3id.org/lcanet/ia#ImpactCategoryIndicator -->


    <owl:Class rdf:about="https://w3id.org/lcanet/ia#ImpactCategoryIndicator"/>
    


    <!-- https://w3id.org/lcanet/ia#LcaResult -->


    <owl:Class rdf:about="https://w3id.org/lcanet/ia#LcaResult">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/lcanet/ia#LcaResult"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://w3id.org/lcanet/core#hasFlowCategory"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/lcanet/activity#FlowTag"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/lcanet/ia#LcaResult"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://w3id.org/lcanet/ia#hasIC"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/lcanet/ia#ImpactCategory"/>
