}, {
  "@id" : "https://w3id.org/lcanet/core",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/terms/contributor" : [ {
    "@id" : "https://orcid.org/0000-0002-4553-3930"
  }, {
    "@id" : "https://orcid.org/0000-0003-3896-7295"
  }, {
    "@id" : "https://orcid.org/0009-0002-7928-9902"
  }, {
    "@value" : "Emmanuelle Core"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@id" : "https://orcid.org/0000-0002-0438-6831"
  } ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "The Core module is the central module of the LCAnet ontology proposed by the SmartACV Carnot Project.\n            It defines the basic elements of a LCA study based on ISO 14040 and ISO 14044 such as the goal, scope, etc. \n            It also imports and links the other LCAnet ontology modules (Activity, Actor, Property, Spatiotemporal, and Impact Assessment)\n            providing an integration layer between the modules.\n            Thus, it serves as a semantic backbone for consistent modeling and reasoning over LCA knowledge."
  } ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-04-30"
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@id" : "https://creativecommons.org/licenses/by/4.0/"
  } ],
  "http://purl.org/dc/terms/publisher" : [ {
    "@id" : "https://www.cea.fr"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "en",
    "@value" : "The Core module of the Life Cycle Assessment Network Ontology (LCAnet)."
  } ],
  "http://purl.org/vocab/vann/preferredNamespacePrefix" : [ {
    "@value" : "core"
  } ],
  "http://purl.org/vocab/vann/preferredNamespaceUri" : [ {
    "@value" : "https://w3id.org/lcanet/core#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "This ontology imports:\n            - Activity module: https://w3id.org/lcanet/activity#\n            - Actor module: https://w3id.org/lcanet/actor#\n            - Impact Assessment module: https://w3id.org/lcanet/ia#\n            - Property module: https://w3id.org/lcanet/property#\n            - Spatiotemporal module: https://w3id.org/lcanet/st#\n        "
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "LCAnet-Core"
  } ],
  "http://www.w3.org/2002/07/owl#imports" : [ {
    "@id" : "https://w3id.org/lcanet/activity"
  }, {
    "@id" : "https://w3id.org/lcanet/actor"
  }, {
    "@id" : "https://w3id.org/lcanet/ia"
  }, {
    "@id" : "https://w3id.org/lcanet/property"
  }, {
    "@id" : "https://w3id.org/lcanet/st"
  } ],
  "http://www.w3.org/2002/07/owl#versionIRI" : [ {
    "@id" : "https://w3id.org/lcanet/core/2.1.0"
  } ],
  "http://www.w3.org/2002/07/owl#versionInfo" : [ {
    "@value" : "2.1.0"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/core#Interpretation",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The Interpretation class connects the LCA model to the Impact Assessment module, representing the analysis and interpretation of results to support decision-making, conclusions, and recommendations."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Interpretation"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/core#LcaModel",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The LCA model class represents a complete Life Cycle Assessment instance within the LCAnet ontology network. \nIts instance ID encapsulates all aspects of the LCA study, linking to scope, goal, life cycle stages, and interpretation results."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "LCA Model"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/core#LifeCycleStage",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The LifeCycle stage class enumerates the standard stages of a product or service life cycle, providing an exhaustive list of the five possible stages for classification and analysis within the LCA."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Life Cycle Stage"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/core#Scope",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "The Scope class captures the boundaries and context of an LCA study, including spatial and temporal aspects, functional unit, system boundaries, and assumptions, and a reference flow. Each element is represented via data properties connecting the Scope class to its corresponding values."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Scope"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/core#activityBelongsToLCstage",
