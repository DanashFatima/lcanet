    "title" : {
      "en" : "The Core module of the Life Cycle Assessment Network Ontology (LCAnet)."
    },
    "iri" : "https://w3id.org/lcanet/core",
    "version" : "2.1.0",
    "author" : [ "https://orcid.org/0000-0002-0438-6831" ],
    "description" : {
      "undefined" : "The Core module is the central module of the LCAnet ontology proposed by the SmartACV Carnot Project.\n            It defines the basic elements of a LCA study based on ISO 14040 and ISO 14044 such as the goal, scope, etc. \n            It also imports and links the other LCAnet ontology modules (Activity, Actor, Property, Spatiotemporal, and Impact Assessment)\n            providing an integration layer between the modules.\n            Thus, it serves as a semantic backbone for consistent modeling and reasoning over LCA knowledge."
    },
    "labels" : {
      "undefined" : "LCAnet-Core"
    },
    "comments" : {
      "undefined" : "This ontology imports:\n            - Activity module: https://w3id.org/lcanet/activity#\n            - Actor module: https://w3id.org/lcanet/actor#\n            - Impact Assessment module: https://w3id.org/lcanet/ia#\n            - Property module: https://w3id.org/lcanet/property#\n            - Spatiotemporal module: https://w3id.org/lcanet/st#\n        "
    },
