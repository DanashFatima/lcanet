    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/lcanet/actor#bearsResponsibility -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/actor#bearsResponsibility">
        <owl:inverseOf rdf:resource="https://w3id.org/lcanet/actor#isBorneBy"/>
        <rdfs:domain rdf:resource="https://w3id.org/lcanet/actor#Agent"/>
        <rdfs:range rdf:resource="https://w3id.org/lcanet/actor#Responsibility"/>
        <rdfs:comment>relates an agent to the responsibility they bear</rdfs:comment>
        <rdfs:label>bears Responsibility</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/actor#entailedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/actor#entailedBy">
        <owl:inverseOf rdf:resource="https://w3id.org/lcanet/actor#entails"/>
        <rdfs:domain rdf:resource="https://w3id.org/lcanet/actor#Responsibility"/>
        <rdfs:range rdf:resource="https://w3id.org/lcanet/actor#Role"/>
        <rdfs:comment>relates a responsibility to the role it is entailed by</rdfs:comment>
        <rdfs:label>entailed By</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/actor#entails -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/actor#entails">
        <rdfs:domain rdf:resource="https://w3id.org/lcanet/actor#Role"/>
        <rdfs:range rdf:resource="https://w3id.org/lcanet/actor#Responsibility"/>
        <rdfs:comment>relates a role to the responsibility it entails</rdfs:comment>
        <rdfs:label>entails</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/actor#inContextOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/actor#inContextOf">
        <rdfs:domain rdf:resource="https://w3id.org/lcanet/actor#Role"/>
        <rdfs:range rdf:resource="https://w3id.org/lcanet/actor#Context"/>
        <rdfs:comment>relates a Role to the Context (e.g., project or process) in which it is instantiated and meaningful.</rdfs:comment>
        <rdfs:label>in Context Of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/actor#isBorneBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/actor#isBorneBy">
        <rdfs:domain rdf:resource="https://w3id.org/lcanet/actor#Responsibility"/>
        <rdfs:range rdf:resource="https://w3id.org/lcanet/actor#Agent"/>
        <rdfs:comment>relates a responsibility to the agent it is borne by</rdfs:comment>
        <rdfs:label>is Borne By</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/actor#playedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/actor#playedBy">
        <owl:inverseOf rdf:resource="https://w3id.org/lcanet/actor#playsRole"/>
        <rdfs:domain rdf:resource="https://w3id.org/lcanet/actor#Role"/>
        <rdfs:range rdf:resource="https://w3id.org/lcanet/actor#Agent"/>
        <rdfs:comment>relates a role to the agent playing it</rdfs:comment>
        <rdfs:label>played By</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/actor#playsRole -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/actor#playsRole">
        <rdfs:domain rdf:resource="https://w3id.org/lcanet/actor#Agent"/>
        <rdfs:range rdf:resource="https://w3id.org/lcanet/actor#Role"/>
        <rdfs:comment>relates an Agent to the Role they play</rdfs:comment>
        <rdfs:label>plays Role</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/Agent -->


    <owl:Class rdf:about="http://purl.org/dc/terms/Agent">
        <owl:equivalentClass rdf:resource="https://w3id.org/lcanet/actor#Agent"/>
    </owl:Class>
    


    <!-- http://xmlns.com/foaf/0.1/Agent -->


    <owl:Class rdf:about="http://xmlns.com/foaf/0.1/Agent">
        <owl:equivalentClass rdf:resource="https://w3id.org/lcanet/actor#Agent"/>
    </owl:Class>
    


    <!-- http://xmlns.com/foaf/0.1/Group -->


    <owl:Class rdf:about="http://xmlns.com/foaf/0.1/Group">
        <owl:equivalentClass rdf:resource="https://w3id.org/lcanet/actor#Group"/>
    </owl:Class>
    


    <!-- http://xmlns.com/foaf/0.1/Organization -->


    <owl:Class rdf:about="http://xmlns.com/foaf/0.1/Organization">
        <owl:equivalentClass rdf:resource="https://w3id.org/lcanet/actor#Organization"/>
    </owl:Class>
    


    <!-- http://xmlns.com/foaf/0.1/Person -->


    <owl:Class rdf:about="http://xmlns.com/foaf/0.1/Person">
        <owl:equivalentClass rdf:resource="https://w3id.org/lcanet/actor#Person"/>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/actor#Agency -->


    <owl:Class rdf:about="https://w3id.org/lcanet/actor#Agency">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/actor#Organization"/>
        <rdfs:comment>An actor capable of intentional action and decision-making.</rdfs:comment>
        <rdfs:label>Agency</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/actor#Agent -->


    <owl:Class rdf:about="https://w3id.org/lcanet/actor#Agent">
        <owl:disjointWith rdf:resource="https://w3id.org/lcanet/actor#Context"/>
        <owl:disjointWith rdf:resource="https://w3id.org/lcanet/actor#Responsibility"/>
        <owl:disjointWith rdf:resource="https://w3id.org/lcanet/actor#Role"/>
        <rdfs:comment>An entity that performs, participates in, or influences activities.</rdfs:comment>
        <rdfs:label>Agent</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/actor#Auditor -->


    <owl:Class rdf:about="https://w3id.org/lcanet/actor#Auditor">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/actor#Role"/>
        <rdfs:comment>Represents a type of role that an agent may assume when evaluating, reviewing, or verifying the conformity and quality of a life cycle assessment study or its results.</rdfs:comment>
        <rdfs:label>Auditor</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/actor#Consumer -->


    <owl:Class rdf:about="https://w3id.org/lcanet/actor#Consumer">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/actor#Role"/>
        <rdfs:comment>epresents a type of role that an agent may assume when using or consuming a product or service during its life cycle.</rdfs:comment>
        <rdfs:label>Consumer</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/actor#Context -->


    <owl:Class rdf:about="https://w3id.org/lcanet/actor#Context">
        <owl:disjointWith rdf:resource="https://w3id.org/lcanet/actor#Responsibility"/>
        <owl:disjointWith rdf:resource="https://w3id.org/lcanet/actor#Role"/>
        <rdfs:comment>A social, institutional, or processual situation that provides the setting in which a Role is played by an Agent and where its associated Responsibilities apply. Examples include projects, collaborations, assessments, or audits.</rdfs:comment>
        <rdfs:label>Context</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/actor#Customer -->


    <owl:Class rdf:about="https://w3id.org/lcanet/actor#Customer">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/actor#Role"/>
        <rdfs:comment>Represents a type of role that an agent may assume when acquiring or purchasing a product or service within its life cycle.</rdfs:comment>
        <rdfs:label>Customer</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/actor#Group -->


    <owl:Class rdf:about="https://w3id.org/lcanet/actor#Group">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/actor#Agent"/>
        <owl:disjointWith rdf:resource="https://w3id.org/lcanet/actor#Person"/>
        <rdfs:comment>A collection of agents acting together as a social unit.</rdfs:comment>
        <rdfs:label>Group</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/actor#Manufacturer -->


    <owl:Class rdf:about="https://w3id.org/lcanet/actor#Manufacturer">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/actor#Role"/>
        <rdfs:comment>Represents a type of role that an agent may assume when performing production or assembly activities within a life cycle system.</rdfs:comment>
        <rdfs:label>Manufacturer</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/actor#Organization -->


    <owl:Class rdf:about="https://w3id.org/lcanet/actor#Organization">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/actor#Agent"/>
        <owl:disjointWith rdf:resource="https://w3id.org/lcanet/actor#Person"/>
        <rdfs:comment>A structured collection of agents pursuing common objectives.</rdfs:comment>
        <rdfs:label>Organization</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/actor#Person -->


    <owl:Class rdf:about="https://w3id.org/lcanet/actor#Person">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/actor#Agent"/>
        <rdfs:comment>A human individual acting as an agent.</rdfs:comment>
        <rdfs:label>Person</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/actor#Recycler -->


    <owl:Class rdf:about="https://w3id.org/lcanet/actor#Recycler">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/actor#Role"/>
        <rdfs:comment>Represents a type of role that an agent may assume when performing recovery, recycling, or treatment operations on products or materials at the end-of-life stage.</rdfs:comment>
        <rdfs:label>Recycler</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/actor#Researcher -->


    <owl:Class rdf:about="https://w3id.org/lcanet/actor#Researcher">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/actor#Role"/>
        <rdfs:comment>Represents a type of role that an agent may assume when conducting analysis, modeling, or scientific studies related to life cycle assessment data, methods, or systems.</rdfs:comment>
        <rdfs:label>Researcher</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/actor#Responsibility -->


    <owl:Class rdf:about="https://w3id.org/lcanet/actor#Responsibility">
        <owl:disjointWith rdf:resource="https://w3id.org/lcanet/actor#Role"/>
        <rdfs:comment>A Responsibility is a relator (a kind of social relation) that connects: the Agent (bearer),
the Role (through which it is borne), and the Action(s) or Goals to which it applies. It include duties, obligations, tasks, etc.
Examples: certify LCA results, verify data quality, etc.</rdfs:comment>
        <rdfs:label>Responsibility</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/actor#Role -->


    <owl:Class rdf:about="https://w3id.org/lcanet/actor#Role">
        <rdfs:comment>Represents a functional role that an agent can assume in a specific context.
Example: LCA Auditor, LCA Agency Role</rdfs:comment>
        <rdfs:label>Role</rdfs:label>
    </owl:Class>
    


