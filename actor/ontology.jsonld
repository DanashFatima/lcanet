  } ]
}, {
  "@id" : "https://w3id.org/lcanet/actor",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/terms/creator" : [ {
    "@id" : "https://orcid.org/0000-0002-0438-6831"
  } ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "The Actor module is part of the LCAnet ontology proposed by the SmartACV Carnot Project. \n            It provides a formal representation of actors (e.g., persons, organizations, and groups) \n            involved in LCA processes, as well as their roles and responsibilities. \n            It resuses some elements from the FOAF (Friend Of A Freind) ontology."
  } ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-05-20"
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@id" : "https://creativecommons.org/licenses/by/4.0/"
  } ],
  "http://purl.org/dc/terms/publisher" : [ {
    "@id" : "https://www.cea.fr"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "en",
    "@value" : "The Actor module of the Life Cycle Assessment Network Ontology (LCAnet)."
  } ],
  "http://purl.org/vocab/vann/preferredNamespacePrefix" : [ {
    "@value" : "actor"
  } ],
  "http://purl.org/vocab/vann/preferredNamespaceUri" : [ {
    "@value" : "https://w3id.org/lcanet/actor#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "LCAnet-Actor"
  } ],
  "http://www.w3.org/2002/07/owl#priorVersion" : [ {
    "@value" : "2.1.0"
  } ],
  "http://www.w3.org/2002/07/owl#versionIRI" : [ {
    "@id" : "https://w3id.org/lcanet/actor/2.2.0"
  } ],
  "http://www.w3.org/2002/07/owl#versionInfo" : [ {
    "@value" : "2.2.0"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/actor#Agency",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "An actor capable of intentional action and decision-making."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Agency"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lcanet/actor#Organization"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/actor#Agent",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "An entity that performs, participates in, or influences activities."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Agent"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/lcanet/actor#Context"
  }, {
    "@id" : "https://w3id.org/lcanet/actor#Responsibility"
  }, {
    "@id" : "https://w3id.org/lcanet/actor#Role"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/actor#Auditor",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Represents a type of role that an agent may assume when evaluating, reviewing, or verifying the conformity and quality of a life cycle assessment study or its results."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Auditor"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lcanet/actor#Role"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/actor#Consumer",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "epresents a type of role that an agent may assume when using or consuming a product or service during its life cycle."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Consumer"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lcanet/actor#Role"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/actor#Context",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A social, institutional, or processual situation that provides the setting in which a Role is played by an Agent and where its associated Responsibilities apply. Examples include projects, collaborations, assessments, or audits."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Context"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/lcanet/actor#Responsibility"
  }, {
    "@id" : "https://w3id.org/lcanet/actor#Role"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/actor#Customer",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Represents a type of role that an agent may assume when acquiring or purchasing a product or service within its life cycle."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Customer"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lcanet/actor#Role"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/actor#Group",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A collection of agents acting together as a social unit."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Group"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lcanet/actor#Agent"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/lcanet/actor#Person"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/actor#Manufacturer",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Represents a type of role that an agent may assume when performing production or assembly activities within a life cycle system."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Manufacturer"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lcanet/actor#Role"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/actor#Organization",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A structured collection of agents pursuing common objectives."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Organization"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lcanet/actor#Agent"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/lcanet/actor#Person"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/actor#Person",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A human individual acting as an agent."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Person"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lcanet/actor#Agent"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/actor#Recycler",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Represents a type of role that an agent may assume when performing recovery, recycling, or treatment operations on products or materials at the end-of-life stage."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Recycler"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lcanet/actor#Role"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/actor#Researcher",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Represents a type of role that an agent may assume when conducting analysis, modeling, or scientific studies related to life cycle assessment data, methods, or systems."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Researcher"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lcanet/actor#Role"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/actor#Responsibility",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A Responsibility is a relator (a kind of social relation) that connects: the Agent (bearer),\nthe Role (through which it is borne), and the Action(s) or Goals to which it applies. It include duties, obligations, tasks, etc.\nExamples: certify LCA results, verify data quality, etc."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Responsibility"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/lcanet/actor#Role"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/actor#Role",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Represents a functional role that an agent can assume in a specific context.\nExample: LCA Auditor, LCA Agency Role"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Role"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/actor#bearsResponsibility",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "relates an agent to the responsibility they bear"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/lcanet/actor#Agent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "bears Responsibility"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/lcanet/actor#Responsibility"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/lcanet/actor#isBorneBy"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/actor#entailedBy",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "relates a responsibility to the role it is entailed by"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/lcanet/actor#Responsibility"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "entailed By"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/lcanet/actor#Role"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/lcanet/actor#entails"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/actor#entails",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "relates a role to the responsibility it entails"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/lcanet/actor#Role"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "entails"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/lcanet/actor#Responsibility"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/actor#inContextOf",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "relates a Role to the Context (e.g., project or process) in which it is instantiated and meaningful."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/lcanet/actor#Role"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "in Context Of"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/lcanet/actor#Context"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/actor#isBorneBy",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "relates a responsibility to the agent it is borne by"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/lcanet/actor#Responsibility"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "is Borne By"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/lcanet/actor#Agent"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/actor#playedBy",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "relates a role to the agent playing it"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
