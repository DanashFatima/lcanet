    "@id" : "https://orcid.org/0000-0002-0438-6831"
  } ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "The Property module is part of the LCAnet ontology proposed by the SmartACV Carnot Project.\n            It provides a formal representation of qualitative and quantitaive properties to \n            LCA processes and flows, enabling the description of LCA data for products or services."
  } ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
