  "http://purl.org/dc/terms/title" : [ {
    "@language" : "en",
    "@value" : "The Property module of the Life Cycle Assessment Network Ontology (LCAnet)."
  } ],
  "http://purl.org/vocab/vann/preferredNamespacePrefix" : [ {
    "@value" : "prop"
  } ],
