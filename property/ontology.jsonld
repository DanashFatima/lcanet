  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A property that represents the quality, reliability, or validity of data associated with an entity or measurement."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Data Quality Property"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lcanet/property#QuantitativeProperty"
  } ]
