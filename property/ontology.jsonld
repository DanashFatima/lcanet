    "@value" : "2.1.0"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/property#BalanceableProperty",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A property representing a flow of materials, energy, or emissions that is tracked and balanced in life cycle assessment studies."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Balanceable Property"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lcanet/property#QuantitativeProperty"
  } ]
}, {
