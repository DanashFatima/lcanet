@base <https://w3id.org/lcanet/property#> .

<https://w3id.org/lcanet/property> rdf:type owl:Ontology ;
                                    owl:versionIRI <https://w3id.org/lcanet/property/2.1.0> ;
                                    <http://purl.org/dc/terms/creator> <https://orcid.org/0000-0002-0438-6831> ;
                                    <http://purl.org/dc/terms/description> """The Property module is part of the LCAnet ontology proposed by the SmartACV Carnot Project.
            It provides a formal representation of qualitative and quantitaive properties to 
            LCA processes and flows, enabling the description of LCA data for products or services.""" ;
                                    <http://purl.org/dc/terms/issued> "2026-04-30"^^xsd:date ;
                                    <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                    <http://purl.org/dc/terms/publisher> <https://www.cea.fr> ;
                                    <http://purl.org/dc/terms/title> "The Property module of the Life Cycle Assessment Network Ontology (LCAnet)."@en ;
                                    <http://purl.org/vocab/vann/preferredNamespacePrefix> "prop" ;
                                    <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/lcanet/property#" ;
                                    rdfs:label "LCAnet-Property" ;
                                    owl:versionInfo "2.1.0" .

