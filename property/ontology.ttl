#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/lcanet/property#hasQualityValue
:hasQualityValue rdf:type owl:DatatypeProperty ;
                 rdfs:domain :QualitativeProperty ;
                 rdfs:range xsd:string ;
                 rdfs:label "has Quality Value" .


###  https://w3id.org/lcanet/property#hasQuantityValue
:hasQuantityValue rdf:type owl:DatatypeProperty ;
                  rdfs:domain :QuantitativeProperty ;
                  rdfs:label "has Quantity Value" .


###  https://w3id.org/lcanet/property#hasUnit
:hasUnit rdf:type owl:DatatypeProperty ;
         rdfs:domain :QuantitativeProperty ;
         rdfs:range xsd:string ;
         rdfs:label "has Unit" .


#################################################################
#    Classes
#################################################################

###  https://w3id.org/lcanet/property#BalanceableProperty
:BalanceableProperty rdf:type owl:Class ;
                     rdfs:subClassOf :QuantitativeProperty ;
                     rdfs:comment "A property representing a flow of materials, energy, or emissions that is tracked and balanced in life cycle assessment studies." ;
                     rdfs:label "Balanceable Property" .


###  https://w3id.org/lcanet/property#DataQualityProperty
:DataQualityProperty rdf:type owl:Class ;
                     rdfs:subClassOf :QuantitativeProperty ;
                     rdfs:comment "A property that represents the quality, reliability, or validity of data associated with an entity or measurement." ;
                     rdfs:label "Data Quality Property" .


###  https://w3id.org/lcanet/property#Property
:Property rdf:type owl:Class ;
          rdfs:label "Property" .


###  https://w3id.org/lcanet/property#QualitativeProperty
:QualitativeProperty rdf:type owl:Class ;
                     rdfs:subClassOf :Property ;
                     rdfs:comment "A property that represents a descriptive or categorical characteristic of an entity." ;
                     rdfs:label "Qualitative Property" .


###  https://w3id.org/lcanet/property#QuantitativeProperty
:QuantitativeProperty rdf:type owl:Class ;
                      rdfs:subClassOf :Property ;
                      rdfs:comment "A property that represents a measurable numeric quantity associated with an entity." ;
                      rdfs:label "Quantitative Property" .


