<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/lcanet/property#"
     xml:base="https://w3id.org/lcanet/property"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://w3id.org/lcanet/property">
        <owl:versionIRI rdf:resource="https://w3id.org/lcanet/property/2.2.0"/>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0438-6831"/>
        <terms:description>The Property module is part of the LCAnet ontology proposed by the SmartACV Carnot Project.
            It provides a formal representation of qualitative and quantitaive properties to 
            LCA processes and flows, enabling the description of LCA data for products or services.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-20</terms:issued>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:publisher rdf:resource="https://www.cea.fr"/>
        <terms:title xml:lang="en">The Property module of the Life Cycle Assessment Network Ontology (LCAnet).</terms:title>
        <vann:preferredNamespacePrefix>prop</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/lcanet/property#</vann:preferredNamespaceUri>
        <rdfs:label>LCAnet-Property</rdfs:label>
        <owl:priorVersion>2.1.0</owl:priorVersion>
        <owl:versionInfo>2.2.0</owl:versionInfo>
    </owl:Ontology>
    


