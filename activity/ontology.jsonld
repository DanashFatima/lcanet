}, {
  "@id" : "https://w3id.org/lcanet/activity",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/terms/creator" : [ {
    "@id" : "https://orcid.org/0000-0002-0438-6831"
  } ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "The Activity module is part of the LCAnet ontology proposed by the SmartACV Carnot Project.\n            It provides a formal representation of activities and their associated flows, enabling \n            the modeling of activity/flow diagrams within the LCA realization of a product or service."
  } ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-05-20"
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@id" : "https://creativecommons.org/licenses/by/4.0/"
  } ],
  "http://purl.org/dc/terms/publisher" : [ {
    "@id" : "https://www.cea.fr"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "en",
    "@value" : "The Activity module of the Life Cycle Assessment Network Ontology (LCAnet)."
  } ],
  "http://purl.org/vocab/vann/preferredNamespacePrefix" : [ {
    "@value" : "act"
  } ],
  "http://purl.org/vocab/vann/preferredNamespaceUri" : [ {
    "@value" : "https://w3id.org/lcanet/activity#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "LCAnet-Activity"
  } ],
  "http://www.w3.org/2002/07/owl#priorVersion" : [ {
    "@value" : "2.1.0"
  } ],
  "http://www.w3.org/2002/07/owl#versionIRI" : [ {
    "@id" : "https://w3id.org/lcanet/activity/2.2.0"
  } ],
  "http://www.w3.org/2002/07/owl#versionInfo" : [ {
    "@value" : "2.2.0"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/activity#Activity",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Represents a process or operation within the LCA system that consumes and/or produces flows."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Activity"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/lcanet/activity#Flow"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/activity#ActivityTag",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A tag for an activity as a way of classification"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Activity Tag"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/activity#Biosphere",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Represents the natural environment external to the technosphere, \nincluding air, water, and soil compartments. It is the domain in which elementary \nflows originate or terminate, such as natural resource extraction and emissions."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Biosphere"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lcanet/activity#EnvironemntalType"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/lcanet/activity#Technosphere"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/activity#ComposedActivity",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "An activity that is made up of multiple sub-activities, which together represent a higher-level process."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Composed Activity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lcanet/activity#Activity"
  }, {
    "@id" : "_:genid1"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/activity#ElementaryFlow",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A flow that connects an activity directly with the natural environment i.e. has a biosphere  boundary."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Elementary Flow"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lcanet/activity#Flow"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/lcanet/activity#IntermediateFlow"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid2"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/activity#EmissionFlow",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Represents an elementary flow corresponding to a substance or energy released from the technosphere into the biosphere. \nIt includes emissions to environmental compartments such as air, water, and soil."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Emission Flow"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lcanet/activity#ElementaryFlow"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/lcanet/activity#ResourceFlow"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid6"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/activity#EnvironemntalType",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A classification of the environment into biosphere or technosphere, used to distinguish whether flows cross system boundaries or remain within the human-made system."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Environmental Type"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/activity#Exchange_Percentage",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#decimal"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/activity#Flow",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Represents the transfer of materials, energy, or resources between activities or between an activity and the environment."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Flow"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "_:genid10"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/activity#FlowTag",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A tag for a flow as a way of classification"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Flow Tag"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/activity#IntermediateFlow",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A flow that connects two activities within the technosphere, serving as an input to one activity and an output from another, or is wasted as waste."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Intermediate Flow"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lcanet/activity#Flow"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid11"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/activity#ProductFlow",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Represents an intermediate flow within the technosphere corresponding to a product, service, or energy carrier with an associated economic value. \nSuch flows are exchanged between activities as intended inputs or outputs within the life cycle system."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Product Flow"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lcanet/activity#IntermediateFlow"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid15"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/activity#ResourceFlow",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Represents an elementary flow corresponding to a substance or energy extracted from the biosphere into the technosphere. \nIt includes natural resources such as minerals, biomass, water, and energy carriers."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Resource Flow"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lcanet/activity#ElementaryFlow"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid23"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/activity#SequencedActivity",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A composed activity in which the constituent sub-activities follow a specific temporal or logical sequence."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Sequenced Activity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lcanet/activity#ComposedActivity"
  }, {
    "@id" : "_:genid27"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/activity#Technosphere",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Represents the system of human activities and industrial processes \nwithin the life cycle of a product or service. It encompasses all transformations \nand exchanges of intermediate flows occurring within the economic system."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Technosphere"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lcanet/activity#EnvironemntalType"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/activity#WasteFlow",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Represents an intermediate flow within the technosphere corresponding to materials or substances that are discarded by an activity and require further treatment, recovery, or disposal. \nThese flows are typically characterized by the absence of positive economic value for the producing activity."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Waste Flow"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lcanet/activity#IntermediateFlow"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/activity#a",
  "@type" : [ "http://www.w3.org/2003/11/swrl#Variable" ]
}, {
  "@id" : "https://w3id.org/lcanet/activity#b",
  "@type" : [ "http://www.w3.org/2003/11/swrl#Variable" ]
}, {
  "@id" : "https://w3id.org/lcanet/activity#connected",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#SymmetricProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "relates two flows together"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/lcanet/activity#Flow"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "connected"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/lcanet/activity#Flow"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/activity#f",
  "@type" : [ "http://www.w3.org/2003/11/swrl#Variable" ]
}, {
  "@id" : "https://w3id.org/lcanet/activity#hasActivityPart",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "relates a composed activity to its composed part activity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/lcanet/activity#ComposedActivity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "has Activity Part"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/lcanet/activity#Activity"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/lcanet/activity#isPartOfActivity"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/activity#hasActivityTag",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#AsymmetricProperty", "http://www.w3.org/2002/07/owl#IrreflexiveProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "relates an activity to its tag"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/lcanet/activity#Activity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "has Activity Tag"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/lcanet/activity#ActivityTag"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/activity#hasEndActivity",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty", "http://www.w3.org/2002/07/owl#AsymmetricProperty", "http://www.w3.org/2002/07/owl#IrreflexiveProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "relates a sequenced activity to its end activity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/lcanet/activity#SequencedActivity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "has End Activity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/lcanet/activity#Activity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "https://w3id.org/lcanet/activity#hasActivityPart"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/lcanet/activity#isEndActivityOf"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/activity#hasEnvironmentalType",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "relates a flow to its environmental type"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/lcanet/activity#Flow"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "has Environmental Type"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/lcanet/activity#EnvironemntalType"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/activity#hasFlowTag",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "relates a flow to its tag"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/lcanet/activity#Flow"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "has Flow Tag"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/lcanet/activity#FlowTag"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/activity#hasInputFlow",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
