  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ]
}, {
  "@id" : "http://www.w3.org/2001/XMLSchema#date",
  "@type" : [ "http://www.w3.org/2000/01/rdf-schema#Datatype" ]
}, {
  "@id" : "http://www.w3.org/2003/01/geo/wgs84_pos#Point",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ]
}, {
  "@id" : "http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ]
}, {
  "@id" : "http://www.w3.org/2006/time#DurationDescription",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ]
}, {
  "@id" : "http://www.w3.org/2006/time#Instant",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ]
}, {
  "@id" : "http://www.w3.org/2006/time#Interval",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ]
}, {
  "@id" : "http://www.w3.org/2006/time#TemporalEntity",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ]
}, {
  "@id" : "http://www.w3.org/2006/time#hasDuration",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2002/07/owl#equivalentProperty" : [ {
    "@id" : "https://w3id.org/lcanet/st#hasDuration"
  } ]
}, {
  "@id" : "https://schema.org/AdministrativeArea",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ]
}, {
  "@id" : "https://schema.org/Place",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ]
}, {
  "@id" : "https://w3id.org/lcanet/st",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/terms/creator" : [ {
    "@id" : "https://orcid.org/0000-0002-0438-6831"
  } ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "The Spatiotemporal module is part of the LCAnet ontology proposed by the SmartACV Carnot Project.\n            It provides a formal representation of spatial and temporal aspects relevant to the LCA process,\n            enabling the modeling and integration of location- and time-specific data for products or services.\n            For the temporal aspect, it reuses classes and properties by importing the Time ontology: Time instant,\n            Time interval, and DurationDescription. For the spatial aspect, it aligns with some pre-defined classes \n            from other ontologies such as the Feature class from the geonames vocabulary."
  } ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2026-05-20"
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@id" : "https://creativecommons.org/licenses/by/4.0/"
  } ],
  "http://purl.org/dc/terms/publisher" : [ {
    "@id" : "https://www.cea.fr"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "en",
    "@value" : "The Spatiotemporal module of the Life Cycle Assessment Network Ontology (LCAnet)."
  } ],
  "http://purl.org/vocab/vann/preferredNamespacePrefix" : [ {
    "@value" : "st"
  } ],
  "http://purl.org/vocab/vann/preferredNamespaceUri" : [ {
    "@value" : "https://w3id.org/lcanet/st#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "LCAnet-Spatiotemporal"
  } ],
  "http://www.w3.org/2002/07/owl#priorVersion" : [ {
    "@value" : "2.1.0"
  } ],
  "http://www.w3.org/2002/07/owl#versionIRI" : [ {
    "@id" : "https://w3id.org/lcanet/st/2.2.0"
  } ],
  "http://www.w3.org/2002/07/owl#versionInfo" : [ {
    "@value" : "2.2.0"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/st#AdministrativeRegion",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A political or administrative territorial unit, such as a country, state, province, or city.\n        Aligns with schema:AdministrativeArea and gn:Feature."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Administrative Region"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://schema.org/AdministrativeArea"
  }, {
    "@id" : "https://w3id.org/lcanet/st#Location"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/lcanet/st#Site"
  }, {
    "@id" : "https://w3id.org/lcanet/st#SpatialScale"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/st#GeoPoint",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A geographic point aligned with WGS84 Point concept."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "GeoPoint"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/2003/01/geo/wgs84_pos#Point"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/st#GlobalScale",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A spatial scale representing the entire planet or worldwide extent."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Global Scale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lcanet/st#SpatialScale"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/st#LocalScale",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A spatial scale representing a localized geographic area, such as a site or municipality level."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Local Scale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lcanet/st#SpatialScale"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/st#Location",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A general spatial entity representing any identifiable place or geographic feature.\n            Equivalent to schema:Place and gn:Feature.\n        "
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Location"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.geonames.org/ontology#Feature"
  }, {
    "@id" : "http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing"
  }, {
    "@id" : "https://schema.org/Place"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/st#NationalScale",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A spatial scale representing the extent of a single country."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "National Scale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lcanet/st#SpatialScale"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/st#RegionalScale",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A spatial scale representing a region, such as a province, state, or aggregated geographic area."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Regional Scale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lcanet/st#SpatialScale"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/st#Site",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "\n            A specific location associated with an activity, facility, installation, or process.\n            Examples: LCA process site, production site, waste treatment site.\n        "
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Site"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/lcanet/st#Location"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/lcanet/st#SpatialScale"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/st#SpatialScale",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "A classification of the level of spatial granularity applied in an LCA study,\n            such as global, national, regional, or local scale.\n            Used for specifying the spatial resolution of data or impacts."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "Spatial Scale"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/st#hasCoordinates",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "\n            Associates a location with a geographic point defined by WGS84 latitude and longitude.\n        "
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/lcanet/st#Location"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "has coordinates"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/lcanet/st#GeoPoint"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/st#hasDuration",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "\n            Specifies the duration of a temporal entity such as a process or interval.\n            Directly corresponds to time:hasDuration.\n        "
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.w3.org/2006/time#TemporalEntity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "has duration"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2006/time#DurationDescription"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/st#hasLocation",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "\n            Relates an entity to a geographic location (Administrative Region or Site) where it takes place or exists.\n        "
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Thing"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "has location"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/lcanet/st#Location"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/st#hasSpatialLocation",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "\n            Indicates the level of spatial granularity (e.g., global, national, regional, local)\n            at which a location or LCA dataset is defined.\n        "
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Thing"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "has spatial scale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/lcanet/st#SpatialScale"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/st#hasTemporalExtent",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "\n            Relates an entity to the time interval during which it exists, occurs, or is valid.\n            Aligned with time:Interval.\n        "
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Thing"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "has temporal extent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2006/time#Interval"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/st#hasTemporalResolution",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "\n            Indicates the temporal granularity or resolution at which data or observations\n            are aggregated or reported (e.g., hourly, monthly, yearly).\n        "
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Thing"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "has temporal resolution"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2006/time#DurationDescription"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/st#inRegion",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "\n            Relates any entity (e.g., process, facility, emission) to an administrative\n            region where it occurs or is assessed.\n        "
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Thing"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "in region"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/lcanet/st#AdministrativeRegion"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/st#locatedIn",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "\n            Indicates that a location is contained within an administrative region (not a Site),\n            such as a city located in a province or country.\n        "
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/lcanet/st#Location"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "located in"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/lcanet/st#AdministrativeRegion"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/st#occursAt",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "\n            Relates an event or process to a specific temporal instant.\n            Aligns conceptually with time:Instant.\n        "
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Thing"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "occurs at"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2006/time#Instant"
  } ]
}, {
  "@id" : "https://w3id.org/lcanet/st#validDuring",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "\n            Indicates the temporal interval for which a dataset, measurement, or assessment is valid.\n        "
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.w3.org/2002/07/owl#Thing"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "valid during"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2006/time#Interval"
  } ]
} ]