<http://purl.org/vocab/vann/preferredNamespaceUri> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.w3.org/2006/time#hasDuration
<http://www.w3.org/2006/time#hasDuration> rdf:type owl:ObjectProperty ;
                                          owl:equivalentProperty :hasDuration .


###  https://w3id.org/lcanet/st#hasCoordinates
:hasCoordinates rdf:type owl:ObjectProperty ;
                rdfs:domain :Location ;
                rdfs:range :GeoPoint ;
                rdfs:comment """
            Associates a location with a geographic point defined by WGS84 latitude and longitude.
        """ ;
                rdfs:label "has coordinates" .


###  https://w3id.org/lcanet/st#hasDuration
:hasDuration rdf:type owl:ObjectProperty ;
             rdfs:domain <http://www.w3.org/2006/time#TemporalEntity> ;
             rdfs:range <http://www.w3.org/2006/time#DurationDescription> ;
             rdfs:comment """
            Specifies the duration of a temporal entity such as a process or interval.
            Directly corresponds to time:hasDuration.
        """ ;
             rdfs:label "has duration" .


###  https://w3id.org/lcanet/st#hasLocation
:hasLocation rdf:type owl:ObjectProperty ;
             rdfs:domain owl:Thing ;
             rdfs:range :Location ;
             rdfs:comment """
            Relates an entity to a geographic location (Administrative Region or Site) where it takes place or exists.
        """ ;
             rdfs:label "has location" .


###  https://w3id.org/lcanet/st#hasSpatialLocation
:hasSpatialLocation rdf:type owl:ObjectProperty ;
                    rdfs:domain owl:Thing ;
                    rdfs:range :SpatialScale ;
                    rdfs:comment """
            Indicates the level of spatial granularity (e.g., global, national, regional, local)
            at which a location or LCA dataset is defined.
        """ ;
                    rdfs:label "has spatial scale" .


###  https://w3id.org/lcanet/st#hasTemporalExtent
:hasTemporalExtent rdf:type owl:ObjectProperty ;
                   rdfs:domain owl:Thing ;
                   rdfs:range <http://www.w3.org/2006/time#Interval> ;
                   rdfs:comment """
            Relates an entity to the time interval during which it exists, occurs, or is valid.
            Aligned with time:Interval.
        """ ;
                   rdfs:label "has temporal extent" .


###  https://w3id.org/lcanet/st#hasTemporalResolution
:hasTemporalResolution rdf:type owl:ObjectProperty ;
                       rdfs:domain owl:Thing ;
                       rdfs:range <http://www.w3.org/2006/time#DurationDescription> ;
                       rdfs:comment """
            Indicates the temporal granularity or resolution at which data or observations
            are aggregated or reported (e.g., hourly, monthly, yearly).
        """ ;
                       rdfs:label "has temporal resolution" .


###  https://w3id.org/lcanet/st#inRegion
:inRegion rdf:type owl:ObjectProperty ;
          rdfs:domain owl:Thing ;
          rdfs:range :AdministrativeRegion ;
          rdfs:comment """
            Relates any entity (e.g., process, facility, emission) to an administrative
            region where it occurs or is assessed.
        """ ;
          rdfs:label "in region" .


###  https://w3id.org/lcanet/st#locatedIn
:locatedIn rdf:type owl:ObjectProperty ;
           rdfs:domain :Location ;
           rdfs:range :AdministrativeRegion ;
           rdfs:comment """
            Indicates that a location is contained within an administrative region (not a Site),
            such as a city located in a province or country.
        """ ;
           rdfs:label "located in" .


###  https://w3id.org/lcanet/st#occursAt
:occursAt rdf:type owl:ObjectProperty ;
          rdfs:domain owl:Thing ;
          rdfs:range <http://www.w3.org/2006/time#Instant> ;
          rdfs:comment """
            Relates an event or process to a specific temporal instant.
            Aligns conceptually with time:Instant.
        """ ;
          rdfs:label "occurs at" .


###  https://w3id.org/lcanet/st#validDuring
:validDuring rdf:type owl:ObjectProperty ;
             rdfs:domain owl:Thing ;
             rdfs:range <http://www.w3.org/2006/time#Interval> ;
             rdfs:comment """
            Indicates the temporal interval for which a dataset, measurement, or assessment is valid.
        """ ;
             rdfs:label "valid during" .


#################################################################
#    Classes
#################################################################

###  http://www.geonames.org/ontology#Feature
<http://www.geonames.org/ontology#Feature> rdf:type owl:Class .


###  http://www.w3.org/2003/01/geo/wgs84_pos#Point
<http://www.w3.org/2003/01/geo/wgs84_pos#Point> rdf:type owl:Class .


###  http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing
<http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> rdf:type owl:Class .


###  http://www.w3.org/2006/time#DurationDescription
<http://www.w3.org/2006/time#DurationDescription> rdf:type owl:Class .


###  http://www.w3.org/2006/time#Instant
<http://www.w3.org/2006/time#Instant> rdf:type owl:Class .


###  http://www.w3.org/2006/time#Interval
<http://www.w3.org/2006/time#Interval> rdf:type owl:Class .


###  http://www.w3.org/2006/time#TemporalEntity
<http://www.w3.org/2006/time#TemporalEntity> rdf:type owl:Class .


###  https://schema.org/AdministrativeArea
<https://schema.org/AdministrativeArea> rdf:type owl:Class .


###  https://schema.org/Place
<https://schema.org/Place> rdf:type owl:Class .


###  https://w3id.org/lcanet/st#AdministrativeRegion
:AdministrativeRegion rdf:type owl:Class ;
                      rdfs:subClassOf <https://schema.org/AdministrativeArea> ,
                                      :Location ;
                      owl:disjointWith :Site ,
                                       :SpatialScale ;
                      rdfs:comment """A political or administrative territorial unit, such as a country, state, province, or city.
        Aligns with schema:AdministrativeArea and gn:Feature.""" ;
                      rdfs:label "Administrative Region" .


###  https://w3id.org/lcanet/st#GeoPoint
:GeoPoint rdf:type owl:Class ;
          rdfs:subClassOf <http://www.w3.org/2003/01/geo/wgs84_pos#Point> ;
          rdfs:comment "A geographic point aligned with WGS84 Point concept." ;
          rdfs:label "GeoPoint" .


###  https://w3id.org/lcanet/st#GlobalScale
:GlobalScale rdf:type owl:Class ;
             rdfs:subClassOf :SpatialScale ;
             rdfs:comment "A spatial scale representing the entire planet or worldwide extent." ;
             rdfs:label "Global Scale" .


###  https://w3id.org/lcanet/st#LocalScale
:LocalScale rdf:type owl:Class ;
            rdfs:subClassOf :SpatialScale ;
            rdfs:comment "A spatial scale representing a localized geographic area, such as a site or municipality level." ;
            rdfs:label "Local Scale" .


###  https://w3id.org/lcanet/st#Location
:Location rdf:type owl:Class ;
          rdfs:subClassOf <http://www.geonames.org/ontology#Feature> ,
                          <http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing> ,
                          <https://schema.org/Place> ;
          rdfs:comment """A general spatial entity representing any identifiable place or geographic feature.
            Equivalent to schema:Place and gn:Feature.
        """ ;
          rdfs:label "Location" .


###  https://w3id.org/lcanet/st#NationalScale
:NationalScale rdf:type owl:Class ;
               rdfs:subClassOf :SpatialScale ;
               rdfs:comment "A spatial scale representing the extent of a single country." ;
               rdfs:label "National Scale" .


###  https://w3id.org/lcanet/st#RegionalScale
:RegionalScale rdf:type owl:Class ;
               rdfs:subClassOf :SpatialScale ;
               rdfs:comment "A spatial scale representing a region, such as a province, state, or aggregated geographic area." ;
               rdfs:label "Regional Scale" .


###  https://w3id.org/lcanet/st#Site
:Site rdf:type owl:Class ;
      rdfs:subClassOf :Location ;
      owl:disjointWith :SpatialScale ;
      rdfs:comment """
            A specific location associated with an activity, facility, installation, or process.
            Examples: LCA process site, production site, waste treatment site.
        """ ;
      rdfs:label "Site" .


###  https://w3id.org/lcanet/st#SpatialScale
:SpatialScale rdf:type owl:Class ;
              rdfs:comment """A classification of the level of spatial granularity applied in an LCA study,
            such as global, national, regional, or local scale.
            Used for specifying the spatial resolution of data or impacts.""" ;
              rdfs:label "Spatial Scale" .


