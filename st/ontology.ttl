@prefix : <https://w3id.org/lcanet/st#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/lcanet/st#> .

<https://w3id.org/lcanet/st> rdf:type owl:Ontology ;
                              owl:versionIRI <https://w3id.org/lcanet/st/2.2.0> ;
                              <http://purl.org/dc/terms/creator> <https://orcid.org/0000-0002-0438-6831> ;
                              <http://purl.org/dc/terms/description> """The Spatiotemporal module is part of the LCAnet ontology proposed by the SmartACV Carnot Project.
            It provides a formal representation of spatial and temporal aspects relevant to the LCA process,
            enabling the modeling and integration of location- and time-specific data for products or services.
            For the temporal aspect, it reuses classes and properties by importing the Time ontology: Time instant,
            Time interval, and DurationDescription. For the spatial aspect, it aligns with some pre-defined classes 
            from other ontologies such as the Feature class from the geonames vocabulary.""" ;
                              <http://purl.org/dc/terms/issued> "2026-05-20"^^xsd:date ;
                              <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                              <http://purl.org/dc/terms/publisher> <https://www.cea.fr> ;
                              <http://purl.org/dc/terms/title> "The Spatiotemporal module of the Life Cycle Assessment Network Ontology (LCAnet)."@en ;
                              <http://purl.org/vocab/vann/preferredNamespacePrefix> "st" ;
                              <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/lcanet/st#" ;
                              rdfs:label "LCAnet-Spatiotemporal" ;
                              owl:priorVersion "2.1.0" ;
                              owl:versionInfo "2.2.0" .

