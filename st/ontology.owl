<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/lcanet/st#"
     xml:base="https://w3id.org/lcanet/st"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://w3id.org/lcanet/st">
        <owl:versionIRI rdf:resource="https://w3id.org/lcanet/st/2.2.0"/>
        <terms:creator rdf:resource="https://orcid.org/0000-0002-0438-6831"/>
        <terms:description>The Spatiotemporal module is part of the LCAnet ontology proposed by the SmartACV Carnot Project.
            It provides a formal representation of spatial and temporal aspects relevant to the LCA process,
            enabling the modeling and integration of location- and time-specific data for products or services.
            For the temporal aspect, it reuses classes and properties by importing the Time ontology: Time instant,
            Time interval, and DurationDescription. For the spatial aspect, it aligns with some pre-defined classes 
            from other ontologies such as the Feature class from the geonames vocabulary.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-20</terms:issued>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:publisher rdf:resource="https://www.cea.fr"/>
        <terms:title xml:lang="en">The Spatiotemporal module of the Life Cycle Assessment Network Ontology (LCAnet).</terms:title>
        <vann:preferredNamespacePrefix>st</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/lcanet/st#</vann:preferredNamespaceUri>
        <rdfs:label>LCAnet-Spatiotemporal</rdfs:label>
        <owl:priorVersion>2.1.0</owl:priorVersion>
        <owl:versionInfo>2.2.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/date -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/date"/>
    


    <!-- http://purl.org/dc/terms/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/issued -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/issued"/>
    


    <!-- http://purl.org/dc/terms/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/publisher -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/publisher"/>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespaceUri -->


    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespaceUri"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2006/time#hasDuration -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/2006/time#hasDuration">
        <owl:equivalentProperty rdf:resource="https://w3id.org/lcanet/st#hasDuration"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/st#hasCoordinates -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/st#hasCoordinates">
        <rdfs:domain rdf:resource="https://w3id.org/lcanet/st#Location"/>
        <rdfs:range rdf:resource="https://w3id.org/lcanet/st#GeoPoint"/>
        <rdfs:comment>
            Associates a location with a geographic point defined by WGS84 latitude and longitude.
        </rdfs:comment>
        <rdfs:label>has coordinates</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/st#hasDuration -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/st#hasDuration">
        <rdfs:domain rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#DurationDescription"/>
        <rdfs:comment>
            Specifies the duration of a temporal entity such as a process or interval.
            Directly corresponds to time:hasDuration.
        </rdfs:comment>
        <rdfs:label>has duration</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/st#hasLocation -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/st#hasLocation">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="https://w3id.org/lcanet/st#Location"/>
        <rdfs:comment>
            Relates an entity to a geographic location (Administrative Region or Site) where it takes place or exists.
        </rdfs:comment>
        <rdfs:label>has location</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/st#hasSpatialLocation -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/st#hasSpatialLocation">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="https://w3id.org/lcanet/st#SpatialScale"/>
        <rdfs:comment>
            Indicates the level of spatial granularity (e.g., global, national, regional, local)
            at which a location or LCA dataset is defined.
        </rdfs:comment>
        <rdfs:label>has spatial scale</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/st#hasTemporalExtent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/st#hasTemporalExtent">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#Interval"/>
        <rdfs:comment>
            Relates an entity to the time interval during which it exists, occurs, or is valid.
            Aligned with time:Interval.
        </rdfs:comment>
        <rdfs:label>has temporal extent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/st#hasTemporalResolution -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/st#hasTemporalResolution">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#DurationDescription"/>
        <rdfs:comment>
            Indicates the temporal granularity or resolution at which data or observations
            are aggregated or reported (e.g., hourly, monthly, yearly).
        </rdfs:comment>
        <rdfs:label>has temporal resolution</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/st#inRegion -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/st#inRegion">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="https://w3id.org/lcanet/st#AdministrativeRegion"/>
        <rdfs:comment>
            Relates any entity (e.g., process, facility, emission) to an administrative
            region where it occurs or is assessed.
        </rdfs:comment>
        <rdfs:label>in region</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/st#locatedIn -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/st#locatedIn">
        <rdfs:domain rdf:resource="https://w3id.org/lcanet/st#Location"/>
        <rdfs:range rdf:resource="https://w3id.org/lcanet/st#AdministrativeRegion"/>
        <rdfs:comment>
            Indicates that a location is contained within an administrative region (not a Site),
            such as a city located in a province or country.
        </rdfs:comment>
        <rdfs:label>located in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/st#occursAt -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/st#occursAt">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#Instant"/>
        <rdfs:comment>
            Relates an event or process to a specific temporal instant.
            Aligns conceptually with time:Instant.
        </rdfs:comment>
        <rdfs:label>occurs at</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lcanet/st#validDuring -->


    <owl:ObjectProperty rdf:about="https://w3id.org/lcanet/st#validDuring">
        <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#Interval"/>
        <rdfs:comment>
            Indicates the temporal interval for which a dataset, measurement, or assessment is valid.
        </rdfs:comment>
        <rdfs:label>valid during</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.geonames.org/ontology#Feature -->


    <owl:Class rdf:about="http://www.geonames.org/ontology#Feature"/>
    


    <!-- http://www.w3.org/2003/01/geo/wgs84_pos#Point -->


    <owl:Class rdf:about="http://www.w3.org/2003/01/geo/wgs84_pos#Point"/>
    


    <!-- http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing -->


    <owl:Class rdf:about="http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing"/>
    


    <!-- http://www.w3.org/2006/time#DurationDescription -->


    <owl:Class rdf:about="http://www.w3.org/2006/time#DurationDescription"/>
    


    <!-- http://www.w3.org/2006/time#Instant -->


    <owl:Class rdf:about="http://www.w3.org/2006/time#Instant"/>
    


    <!-- http://www.w3.org/2006/time#Interval -->


    <owl:Class rdf:about="http://www.w3.org/2006/time#Interval"/>
    


    <!-- http://www.w3.org/2006/time#TemporalEntity -->


    <owl:Class rdf:about="http://www.w3.org/2006/time#TemporalEntity"/>
    


    <!-- https://schema.org/AdministrativeArea -->


    <owl:Class rdf:about="https://schema.org/AdministrativeArea"/>
    


    <!-- https://schema.org/Place -->


    <owl:Class rdf:about="https://schema.org/Place"/>
    


    <!-- https://w3id.org/lcanet/st#AdministrativeRegion -->


    <owl:Class rdf:about="https://w3id.org/lcanet/st#AdministrativeRegion">
        <rdfs:subClassOf rdf:resource="https://schema.org/AdministrativeArea"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/st#Location"/>
        <owl:disjointWith rdf:resource="https://w3id.org/lcanet/st#Site"/>
        <owl:disjointWith rdf:resource="https://w3id.org/lcanet/st#SpatialScale"/>
        <rdfs:comment>A political or administrative territorial unit, such as a country, state, province, or city.
        Aligns with schema:AdministrativeArea and gn:Feature.</rdfs:comment>
        <rdfs:label>Administrative Region</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/st#GeoPoint -->


    <owl:Class rdf:about="https://w3id.org/lcanet/st#GeoPoint">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2003/01/geo/wgs84_pos#Point"/>
        <rdfs:comment>A geographic point aligned with WGS84 Point concept.</rdfs:comment>
        <rdfs:label>GeoPoint</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/st#GlobalScale -->


    <owl:Class rdf:about="https://w3id.org/lcanet/st#GlobalScale">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/st#SpatialScale"/>
        <rdfs:comment>A spatial scale representing the entire planet or worldwide extent.</rdfs:comment>
        <rdfs:label>Global Scale</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/st#LocalScale -->


    <owl:Class rdf:about="https://w3id.org/lcanet/st#LocalScale">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/st#SpatialScale"/>
        <rdfs:comment>A spatial scale representing a localized geographic area, such as a site or municipality level.</rdfs:comment>
        <rdfs:label>Local Scale</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/st#Location -->


    <owl:Class rdf:about="https://w3id.org/lcanet/st#Location">
        <rdfs:subClassOf rdf:resource="http://www.geonames.org/ontology#Feature"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing"/>
        <rdfs:subClassOf rdf:resource="https://schema.org/Place"/>
        <rdfs:comment>A general spatial entity representing any identifiable place or geographic feature.
            Equivalent to schema:Place and gn:Feature.
        </rdfs:comment>
        <rdfs:label>Location</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/st#NationalScale -->


    <owl:Class rdf:about="https://w3id.org/lcanet/st#NationalScale">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/st#SpatialScale"/>
        <rdfs:comment>A spatial scale representing the extent of a single country.</rdfs:comment>
        <rdfs:label>National Scale</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/st#RegionalScale -->


    <owl:Class rdf:about="https://w3id.org/lcanet/st#RegionalScale">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/st#SpatialScale"/>
        <rdfs:comment>A spatial scale representing a region, such as a province, state, or aggregated geographic area.</rdfs:comment>
        <rdfs:label>Regional Scale</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/st#Site -->


    <owl:Class rdf:about="https://w3id.org/lcanet/st#Site">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lcanet/st#Location"/>
        <owl:disjointWith rdf:resource="https://w3id.org/lcanet/st#SpatialScale"/>
        <rdfs:comment>
            A specific location associated with an activity, facility, installation, or process.
            Examples: LCA process site, production site, waste treatment site.
        </rdfs:comment>
        <rdfs:label>Site</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/lcanet/st#SpatialScale -->


    <owl:Class rdf:about="https://w3id.org/lcanet/st#SpatialScale">
        <rdfs:comment>A classification of the level of spatial granularity applied in an LCA study,
            such as global, national, regional, or local scale.
            Used for specifying the spatial resolution of data or impacts.</rdfs:comment>
        <rdfs:label>Spatial Scale</rdfs:label>
    </owl:Class>
</rdf:RDF>



